          <string name="Source"><![CDATA[-- Paste Roblox asset ids here after uploading the files from /audio (see audio/README.md).
-- Empty strings fall back to built-in engine sounds (sfx) or silence (music), so the game always runs.
-- Accepts "123456789", 123456789 or "rbxassetid://123456789".
return {
	sfx = {
		click = "", buy = "", deny = "", cash = "", coin = "", checkpoint = "", floor_clear = "", death = "", bounce = "",
		speed = "", overdrive = "", unlock = "", jump2 = "",
	},
	music = {
		hub = "", zone_a = "", zone_b = "", zone_c = "", zone_d = "", zone_e = "", zone_f = "",
	},
}
]]></string>
        </Properties>
