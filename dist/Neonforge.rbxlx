      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- NEONFORGE: Tower Tycoon - central configuration.
-- Every number that affects progression lives here. Ids are save keys: never rename, only add.
local Config = {}

Config.NAME = "NEONFORGE"
Config.DATA_VERSION = 1

-- ===== tower geometry (shared by the baker, the server and the tests) =====
Config.Tower = {
	FLOORS = 12,
	MODULES_PER_FLOOR = 7, -- 1 checkpoint plaza + 6 obstacle modules
	PATH_RADIUS = 90, -- distance of the path centreline from the tower axis
	PATH_WIDTH = 20,
	MODULE_LENGTH = 44,
	CONNECTOR = 11, -- solid walkway at each end of an obstacle module (obstacles live in the 22 studs between)
	JOINT_RADIUS = 10.5, -- round plate that fills the corner between two modules
	RISE_PER_MODULE = 3.5,
	BASE_Y = 6, -- height of the first checkpoint plaza surface
	CORE_RADIUS = 55,
	MIN_FLOOR_SECONDS = 18, -- anti-teleport: a floor can never be cleared faster than this
	FALL_MARGIN = 70, -- falling this far below the checkpoint returns you to it
}

-- the ring of tycoon plots around the hub island (plot-local: +X along the belt, -Z towards the tower)
Config.Plots = {
	COUNT = 8,
	RING_RADIUS = 330,
	SIZE = 110,
	BUTTON_Z = 24, -- where the buy button stands (behind the factory)
	BELT_Y = 2.2,
}

-- ===== themes: one per floor =====
-- main/accent/glow colours, terrain-free materials, lighting + ambience used by the client per floor
Config.Floors = {
	{ id = 1, name = "Candy Foundry", main = { 255, 150, 205 }, accent = { 255, 236, 130 }, glow = { 255, 70, 160 }, material = "SmoothPlastic",
		sky = { top = { 255, 190, 230 }, haze = { 255, 150, 210 }, ambient = { 190, 130, 170 }, brightness = 2.6, clock = 15.5, particles = "sparkle" }, music = "zone_a" },
	{ id = 2, name = "Mossy Ruins", main = { 96, 150, 96 }, accent = { 210, 196, 140 }, glow = { 120, 255, 150 }, material = "Cobblestone",
		sky = { top = { 170, 235, 190 }, haze = { 140, 200, 150 }, ambient = { 120, 160, 120 }, brightness = 2.3, clock = 13, particles = "leaf" }, music = "zone_a" },
	{ id = 3, name = "Lava Forge", main = { 74, 52, 52 }, accent = { 255, 120, 40 }, glow = { 255, 90, 20 }, material = "Basalt",
		sky = { top = { 255, 130, 60 }, haze = { 200, 70, 30 }, ambient = { 150, 80, 60 }, brightness = 2.0, clock = 18, particles = "ember" }, music = "zone_b" },
	{ id = 4, name = "Frost Vault", main = { 190, 230, 255 }, accent = { 120, 190, 255 }, glow = { 150, 230, 255 }, material = "Ice",
		sky = { top = { 190, 225, 255 }, haze = { 200, 235, 255 }, ambient = { 150, 180, 220 }, brightness = 2.8, clock = 12, particles = "snow" }, music = "zone_b" },
	{ id = 5, name = "Neon Arcade", main = { 34, 22, 66 }, accent = { 255, 60, 200 }, glow = { 60, 255, 240 }, material = "SmoothPlastic",
		sky = { top = { 60, 20, 110 }, haze = { 120, 40, 170 }, ambient = { 80, 50, 140 }, brightness = 1.6, clock = 22, particles = "sparkle" }, music = "zone_c" },
	{ id = 6, name = "Toxic Labs", main = { 64, 92, 74 }, accent = { 186, 255, 70 }, glow = { 120, 255, 40 }, material = "Metal",
		sky = { top = { 170, 255, 120 }, haze = { 110, 190, 70 }, ambient = { 100, 150, 90 }, brightness = 2.0, clock = 17, particles = "bubble" }, music = "zone_c" },
	{ id = 7, name = "Clockwork Heights", main = { 150, 110, 64 }, accent = { 242, 202, 104 }, glow = { 255, 224, 130 }, material = "DiamondPlate",
		sky = { top = { 255, 220, 150 }, haze = { 220, 170, 100 }, ambient = { 170, 140, 100 }, brightness = 2.4, clock = 16.5, particles = "dust" }, music = "zone_d" },
	{ id = 8, name = "Crystal Caverns", main = { 92, 72, 164 }, accent = { 204, 124, 255 }, glow = { 124, 204, 255 }, material = "Marble",
		sky = { top = { 140, 110, 230 }, haze = { 100, 70, 190 }, ambient = { 100, 90, 170 }, brightness = 1.8, clock = 21, particles = "sparkle" }, music = "zone_d" },
	{ id = 9, name = "Cloud Garden", main = { 250, 250, 255 }, accent = { 255, 204, 224 }, glow = { 255, 242, 166 }, material = "SmoothPlastic",
		sky = { top = { 160, 215, 255 }, haze = { 230, 240, 255 }, ambient = { 200, 210, 235 }, brightness = 3.0, clock = 11, particles = "petal" }, music = "zone_e" },
	{ id = 10, name = "Storm Spire", main = { 60, 72, 102 }, accent = { 204, 224, 255 }, glow = { 150, 200, 255 }, material = "Concrete",
		sky = { top = { 70, 85, 130 }, haze = { 60, 70, 100 }, ambient = { 90, 100, 140 }, brightness = 1.7, clock = 19, particles = "rain" }, music = "zone_e" },
	{ id = 11, name = "Void Rift", main = { 16, 10, 32 }, accent = { 150, 60, 255 }, glow = { 255, 60, 120 }, material = "Slate",
		sky = { top = { 20, 8, 50 }, haze = { 70, 20, 120 }, ambient = { 70, 40, 110 }, brightness = 1.3, clock = 0, particles = "void" }, music = "zone_f" },
	{ id = 12, name = "Starcrown Summit", main = { 255, 216, 104 }, accent = { 255, 255, 255 }, glow = { 255, 240, 170 }, material = "Foil",
		sky = { top = { 30, 20, 80 }, haze = { 255, 200, 120 }, ambient = { 200, 170, 140 }, brightness = 2.6, clock = 5.8, particles = "star" }, music = "zone_f" },
}

-- ===== tycoon =====
Config.Tycoon = {
	PLOTS = 8,
	ORE_LIFETIME = 18,
	MAX_ORE_PER_PLOT = 36,
	CROWN_BONUS = 0.05, -- cash multiplier per crown
	OVERDRIVE_BONUS = 0.75, -- cash multiplier per Overdrive
	OVERDRIVE_HEADSTART = 400, -- starting cash after an Overdrive, per Overdrive count
	COST_RAMP = 0.32, -- every purchase in the list is this much pricier than the one before it (x(1 + RAMP*n)) on top of the listed cost
	OVERDRIVE_COST_GROWTH = 0.6, -- factory pieces cost this much more per Overdrive (keeps repeat cycles meaningful)
	BELT_SPEED = 9,
}

-- kind: dropper (spawns ore worth `value` every `interval`s), upgrader (x`mult` to every ore), generator (+`rate` cash/s),
-- collector (`bonus` x cash from ore), decor (cosmetic), overdrive (unlocks Overdrive).  x = position along the belt.
-- Items marked free are owned at the start of every cycle.
Config.Items = {
	{ id = "dropper_rusty", name = "Rusty Dropper", kind = "dropper", cost = 0, free = true, x = -32, value = 2, interval = 1.5, color = { 220, 130, 70 } },
	{ id = "collector_basic", name = "Collector", kind = "collector", cost = 0, free = true, x = 34, bonus = 1 },
	{ id = "up_polisher", name = "Polisher x2", kind = "upgrader", cost = 40, x = -10, mult = 2, color = { 255, 200, 90 } },
	{ id = "dropper_copper", name = "Copper Dropper", kind = "dropper", cost = 120, x = -26, value = 5, interval = 1.5, color = { 255, 140, 90 } },
	{ id = "up_smelter", name = "Smelter x2", kind = "upgrader", cost = 400, x = 0, mult = 2, color = { 255, 110, 60 } },
	{ id = "dropper_silver", name = "Silver Dropper", kind = "dropper", cost = 1100, x = -20, value = 12, interval = 1.5, color = { 210, 225, 245 } },
	{ id = "gen_spark", name = "Spark Generator", kind = "generator", cost = 2400, x = 8, rate = 14, color = { 255, 240, 120 } },
	{ id = "up_quantum", name = "Quantum Gate x3", kind = "upgrader", cost = 7000, x = 10, mult = 3, color = { 120, 200, 255 } },
	{ id = "decor_lights", name = "Neon Roof Lights", kind = "decor", cost = 9000, x = 0, color = { 255, 90, 200 } },
	{ id = "dropper_gold", name = "Gold Dropper", kind = "dropper", cost = 20000, x = -14, value = 30, interval = 1.5, color = { 255, 215, 80 } },
	{ id = "up_prism", name = "Prism Press x3", kind = "upgrader", cost = 60000, x = 20, mult = 3, color = { 255, 120, 220 } },
	{ id = "dropper_diamond", name = "Diamond Dropper", kind = "dropper", cost = 160000, x = -8, value = 90, interval = 1.5, color = { 150, 240, 255 } },
	{ id = "gen_reactor", name = "Fusion Reactor", kind = "generator", cost = 380000, x = 14, rate = 300, color = { 120, 255, 200 } },
	{ id = "decor_fans", name = "Turbine Fans", kind = "decor", cost = 500000, x = 0, color = { 180, 200, 255 } },
	{ id = "up_singularity", name = "Singularity x4", kind = "upgrader", cost = 1000000, x = 28, mult = 4, color = { 170, 90, 255 } },
	{ id = "dropper_neon", name = "Neon Core Dropper", kind = "dropper", cost = 3000000, x = -2, value = 300, interval = 1.5, color = { 80, 255, 220 } },
	{ id = "dropper_void", name = "Void Dropper", kind = "dropper", cost = 10000000, x = 4, value = 1000, interval = 1.5, color = { 190, 80, 255 } },
	{ id = "collector_mega", name = "Mega Collector x1.5", kind = "collector", cost = 30000000, x = 34, bonus = 1.5 },
	{ id = "overdrive_reactor", name = "Overdrive Reactor", kind = "overdrive", cost = 80000000, x = 0, color = { 255, 80, 120 } },
}

-- ===== obby rewards / perks / cosmetics =====
Config.Obby = {
	FIRST_CLEAR_CASH_BASE = 250, -- x floor^2, or INCOME_SECONDS of income x floor, whichever is larger
	INCOME_SECONDS = 25,
	REPEAT_FRACTION = 0.15,
	SUMMIT_BONUS_CROWNS = 20,
	COIN_CASH = 6, -- x floor
	SKIP_BASE = 2500, -- x floor^2
	CHECKPOINT_REACH_RADIUS = 34,
}

Config.Perks = {
	{ id = "speed_coil", name = "Speed Coil", cost = 1500, desc = "Walk speed 16 -> 21.", walk = 21 },
	{ id = "coin_magnet", name = "Coin Magnet", cost = 6000, desc = "Coins fly to you from 22 studs.", magnet = 22 },
	{ id = "gravity_boots", name = "Gravity Boots", cost = 25000, desc = "Jump power 50 -> 58.", jump = 58 },
	{ id = "double_jump", name = "Double Jump", cost = 150000, desc = "Jump again in mid-air.", double = true },
}

-- trails unlock on the first clear of their floor; auras unlock at crown totals
Config.Trails = {}
for _, f in Config.Floors do
	table.insert(Config.Trails, { id = "trail_" .. f.id, name = f.name .. " Trail", floor = f.id, color = f.glow, accent = f.accent })
end
Config.Auras = {
	{ id = "aura_spark", name = "Spark Aura", crowns = 10, color = { 255, 240, 120 } },
	{ id = "aura_flame", name = "Inferno Aura", crowns = 25, color = { 255, 110, 40 } },
	{ id = "aura_galaxy", name = "Galaxy Aura", crowns = 50, color = { 170, 100, 255 } },
	{ id = "aura_crown", name = "Starcrown Aura", crowns = 90, color = { 255, 220, 120 } },
}

Config.Titles = {
	{ id = "Newcomer", crowns = 0 }, { id = "Apprentice Smith", crowns = 3 }, { id = "Forge Runner", crowns = 10 },
	{ id = "Tower Climber", crowns = 30 }, { id = "Neon Master", crowns = 60 }, { id = "Tower Conqueror", crowns = 98 },
}

-- ===== audio (see audio/README.md: upload the files, paste the asset ids into AudioIds.luau) =====
-- engine fallbacks are used while an id is empty so the game is never silent in Studio
Config.Sfx = {
	click = { fallback = "rbxasset://sounds/button.wav", volume = 0.25, pitch = 1.0 },
	buy = { fallback = "rbxasset://sounds/victory.wav", volume = 0.4, pitch = 1.2 },
	deny = { fallback = "rbxasset://sounds/button.wav", volume = 0.35, pitch = 0.6 },
	cash = { fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.3, pitch = 1.6 },
	coin = { fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.4, pitch = 2.0 },
	checkpoint = { fallback = "rbxasset://sounds/victory.wav", volume = 0.45, pitch = 1.5 },
	floor_clear = { fallback = "rbxasset://sounds/victory.wav", volume = 0.6, pitch = 1.0 },
	death = { fallback = "rbxasset://sounds/uuhhh.mp3", volume = 0.4, pitch = 1.0 },
	bounce = { fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.4, pitch = 0.8 },
	speed = { fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.4, pitch = 2.4 },
	overdrive = { fallback = "rbxasset://sounds/victory.wav", volume = 0.7, pitch = 0.7 },
	unlock = { fallback = "rbxasset://sounds/victory.wav", volume = 0.5, pitch = 1.8 },
	jump2 = { fallback = "rbxasset://sounds/switch.wav", volume = 0.35, pitch = 1.6 },
}

Config.Colors = {
	cyan = { 70, 240, 255 }, magenta = { 255, 70, 200 }, gold = { 255, 215, 90 }, dark = { 18, 14, 36 }, panel = { 30, 24, 58 },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Profile</string>
          <string name="Source"><![CDATA[-- Save schema + defensive reconcile of whatever the DataStore returned.
local Config = require(script.Parent.Config)

local Profile = {}

local function num(v: any, default: number, lo: number?, hi: number?): number
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return math.clamp(v, lo or -1e300, hi or 1e300)
end

local function idSet(src: any, valid: { [string]: boolean }): { [string]: boolean }
	local out = {}
	if type(src) == "table" then
		for k, v in src do
			if type(k) == "string" and v == true and valid[k] then
				out[k] = true
			end
		end
	end
	return out
end

local function ids(list: { { id: string } }): { [string]: boolean }
	local o = {}
	for _, e in list do
		o[e.id] = true
	end
	return o
end

Profile.validItems = ids(Config.Items)
Profile.validPerks = ids(Config.Perks)
Profile.validTrails = ids(Config.Trails)
Profile.validAuras = ids(Config.Auras)
Profile.validTitles = ids(Config.Titles)

function Profile.default()
	local items = {}
	for _, it in Config.Items do
		if it.free then
			items[it.id] = true
		end
	end
	return {
		v = Config.DATA_VERSION,
		cash = 0,
		crowns = 0,
		overdrive = 0,
		items = items,
		floors = {}, -- ["1"] = true once cleared (string keys keep DataStore tables dictionaries)
		reached = 1, -- highest floor whose checkpoint was reached
		checkpoint = 1, -- floor checkpoint used for respawning
		perks = {},
		trails = {},
		auras = {},
		trail = "",
		aura = "",
		title = "Newcomer",
		stats = { deaths = 0, coins = 0, floorsCleared = 0, playSeconds = 0, cashEarned = 0, skips = 0, ores = 0 },
		settings = { music = true, sfx = true, shake = true },
	}
end

function Profile.reconcile(raw: any)
	local p = Profile.default()
	if type(raw) ~= "table" then
		return p
	end
	p.cash = math.floor(num(raw.cash, 0, 0))
	p.crowns = math.floor(num(raw.crowns, 0, 0, 100000))
	p.overdrive = math.floor(num(raw.overdrive, 0, 0, 10000))
	p.items = idSet(raw.items, Profile.validItems)
	for _, it in Config.Items do
		if it.free then
			p.items[it.id] = true
		end
	end
	if type(raw.floors) == "table" then
		for k, v in raw.floors do
			local n = tonumber(k)
			if v == true and n and n >= 1 and n <= Config.Tower.FLOORS and n == math.floor(n) then
				p.floors[tostring(n)] = true
			end
		end
	end
	p.reached = math.floor(num(raw.reached, 1, 1, Config.Tower.FLOORS))
	p.checkpoint = math.floor(num(raw.checkpoint, 1, 1, p.reached))
	p.perks = idSet(raw.perks, Profile.validPerks)
	p.trails = idSet(raw.trails, Profile.validTrails)
	p.auras = idSet(raw.auras, Profile.validAuras)
	if type(raw.trail) == "string" and p.trails[raw.trail] then
		p.trail = raw.trail
	end
	if type(raw.aura) == "string" and p.auras[raw.aura] then
		p.aura = raw.aura
	end
	if type(raw.title) == "string" and Profile.validTitles[raw.title] then
		p.title = raw.title
	end
	if type(raw.stats) == "table" then
		for k in p.stats do
			p.stats[k] = math.floor(num(raw.stats[k], 0, 0))
		end
	end
	if type(raw.settings) == "table" then
		for k in p.settings do
			if type(raw.settings[k]) == "boolean" then
				p.settings[k] = raw.settings[k]
			end
		end
	end
	return p
end

return Profile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Remotes under ReplicatedStorage.Remotes. Client -> server calls are untrusted input: every handler validates
-- types, ids, ownership, distance and rate.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local EVENTS = {
	"State", -- server -> client: profile snapshot
	"Notify", -- server -> client: one-off feedback ({kind=...})
	"CashTick", -- server -> client: (amount, ores) batched factory income
	"Launch", -- server -> client: (upSpeed) bounce pad impulse applied by the client to its own character
	"ClientReady", -- client -> server
	"Jumped2", -- client -> server: used a double jump (only to play effects for others)
}
local FUNCTIONS = {
	"Buy", -- (itemId)
	"BuyPerk", -- (perkId)
	"Skip", -- ()
	"GotoFloor", -- (floor)
	"Overdrive", -- ()
	"Equip", -- (kind, id)
	"SetSetting", -- (key, boolean)
	"Teleport", -- ("tower" | "home")
}

function Remotes.create()
	assert(RunService:IsServer())
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = folder
	end
	for _, name in FUNCTIONS do
		local f = Instance.new("RemoteFunction")
		f.Name = name
		f.Parent = folder
	end
	folder.Parent = ReplicatedStorage
end

function Remotes.get(name: string): any
	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[-- All game rules as pure functions over a profile table (no Roblox instances, no yielding).
-- The server calls these so every mutation is atomic; the tests drive them directly.
local Config = require(script.Parent.Config)
local Profile = require(script.Parent.Profile)

local Rules = {}

local T = Config.Tycoon

local itemById: { [string]: any } = {}
local itemIndex: { [string]: number } = {}
for i, it in Config.Items do
	itemById[it.id] = it
	itemIndex[it.id] = i
end
Rules.itemById = itemById
local perkById: { [string]: any } = {}
for _, p in Config.Perks do
	perkById[p.id] = p
end
Rules.perkById = perkById

-- ===== multipliers / income =====
function Rules.cashMult(profile): number
	return (1 + T.CROWN_BONUS * profile.crowns) * (1 + T.OVERDRIVE_BONUS * profile.overdrive)
end

local paidOrdinal: { [string]: number } = {}
do
	local n = 0
	for _, it in Config.Items do
		if not it.free then
			n += 1
			paidOrdinal[it.id] = n
		end
	end
end

-- listed cost, ramped up the list, and inflated per Overdrive when a profile is given
function Rules.itemCost(item, profile: any?): number
	local ramp = 1 + T.COST_RAMP * (paidOrdinal[item.id] or 0)
	local od = if profile then 1 + T.OVERDRIVE_COST_GROWTH * profile.overdrive else 1
	return math.floor(item.cost * ramp * od)
end

-- product of every owned upgrader multiplier (all upgraders sit downstream of all droppers by layout)
function Rules.upgradeMult(profile): number
	local m = 1
	for _, it in Config.Items do
		if it.kind == "upgrader" and profile.items[it.id] then
			m *= it.mult
		end
	end
	return m
end

function Rules.collectorBonus(profile): number
	local b = 1
	for _, it in Config.Items do
		if it.kind == "collector" and profile.items[it.id] then
			b = math.max(b, it.bonus)
		end
	end
	return b
end

-- cash value of one ore from `dropperId` when it reaches the collector
function Rules.oreValue(profile, dropperId: string): number
	local d = itemById[dropperId]
	if not d or d.kind ~= "dropper" then
		return 0
	end
	return d.value * Rules.upgradeMult(profile) * Rules.collectorBonus(profile) * Rules.cashMult(profile)
end

-- expected cash per second of the factory (used by objectives, rewards and the economy simulation)
function Rules.income(profile): number
	local total = 0
	local mult = Rules.upgradeMult(profile) * Rules.collectorBonus(profile) * Rules.cashMult(profile)
	for _, it in Config.Items do
		if profile.items[it.id] then
			if it.kind == "dropper" then
				total += it.value / it.interval * mult
			elseif it.kind == "generator" then
				total += it.rate * Rules.cashMult(profile) * Rules.collectorBonus(profile)
			end
		end
	end
	return total
end

-- ===== buying factory pieces =====
-- pieces unlock in the listed order: an item can be bought once the previous non-free item is owned
function Rules.previousItem(id: string): any?
	local idx = itemIndex[id]
	if not idx then
		return nil
	end
	for i = idx - 1, 1, -1 do
		if not Config.Items[i].free then
			return Config.Items[i]
		end
	end
	return nil
end

function Rules.canBuyItem(profile, id: any): (boolean, string, number)
	if type(id) ~= "string" then
		return false, "invalid", 0
	end
	local it = itemById[id]
	if not it then
		return false, "invalid", 0
	end
	local cost = Rules.itemCost(it, profile)
	if profile.items[id] then
		return false, "owned", cost
	end
	local prev = Rules.previousItem(id)
	if prev and not profile.items[prev.id] then
		return false, "locked", cost
	end
	if profile.cash < cost then
		return false, "funds", cost
	end
	return true, "ok", cost
end

function Rules.buyItem(profile, id: any): (boolean, string)
	local ok, reason, cost = Rules.canBuyItem(profile, id)
	if not ok then
		return false, reason
	end
	profile.cash -= cost
	profile.items[id] = true
	return true, "ok"
end

function Rules.nextItem(profile): any?
	for _, it in Config.Items do
		if not profile.items[it.id] then
			return it
		end
	end
	return nil
end

-- ===== cash in =====
function Rules.addCash(profile, amount: number)
	if amount <= 0 then
		return
	end
	profile.cash += amount
	profile.stats.cashEarned += math.floor(amount)
end

-- ===== overdrive (prestige) =====
function Rules.canOverdrive(profile): boolean
	return profile.items.overdrive_reactor == true
end

-- Resets the factory; keeps crowns, floors, perks and cosmetics. Returns false if not allowed.
function Rules.overdrive(profile): boolean
	if not Rules.canOverdrive(profile) then
		return false
	end
	local fresh = Profile.default()
	profile.items = fresh.items
	profile.overdrive += 1
	profile.cash = T.OVERDRIVE_HEADSTART * profile.overdrive
	return true
end

-- ===== obby =====
function Rules.floorReward(profile, floor: number): (number, number)
	local crowns = floor
	local cash = math.max(Config.Obby.FIRST_CLEAR_CASH_BASE * floor * floor, Rules.income(profile) * Config.Obby.INCOME_SECONDS * floor)
	return crowns, math.floor(cash)
end

function Rules.titleFor(crowns: number): string
	local t = Config.Titles[1].id
	for _, e in Config.Titles do
		if crowns >= e.crowns then
			t = e.id
		end
	end
	return t
end

-- Applies derived unlocks (trails, auras, titles). Returns a list of { kind, id } for notifications.
function Rules.unlocks(profile): { { kind: string, id: string } }
	local out = {}
	for _, tr in Config.Trails do
		if profile.floors[tostring(tr.floor)] and not profile.trails[tr.id] then
			profile.trails[tr.id] = true
			if profile.trail == "" then
				profile.trail = tr.id
			end
			table.insert(out, { kind = "trail", id = tr.id })
		end
	end
	for _, au in Config.Auras do
		if profile.crowns >= au.crowns and not profile.auras[au.id] then
			profile.auras[au.id] = true
			if profile.aura == "" then
				profile.aura = au.id
			end
			table.insert(out, { kind = "aura", id = au.id })
		end
	end
	local title = Rules.titleFor(profile.crowns)
	if title ~= profile.title and Profile.validTitles[title] then
		-- only move the title forward automatically
		local cur
		for i, e in Config.Titles do
			if e.id == profile.title then
				cur = i
			end
		end
		for i, e in Config.Titles do
			if e.id == title and (not cur or i > cur) then
				profile.title = title
				table.insert(out, { kind = "title", id = title })
			end
		end
	end
	return out
end

-- Record reaching floor `floor`'s checkpoint. Returns false when the floor is not yet reachable.
function Rules.reachFloor(profile, floor: any): boolean
	if type(floor) ~= "number" or floor ~= math.floor(floor) or floor < 1 or floor > Config.Tower.FLOORS then
		return false
	end
	if floor > profile.reached + 1 then
		return false
	end
	-- checkpoint floor+1 is never accepted before floor is cleared; reaching floor N+1 clears N (see clearFloor)
	profile.reached = math.max(profile.reached, floor)
	profile.checkpoint = floor
	return true
end

-- Clear `floor` (first time pays crowns + cash + trail, repeats pay a small cash amount). Returns result or nil.
function Rules.clearFloor(profile, floor: any)
	if type(floor) ~= "number" or floor ~= math.floor(floor) or floor < 1 or floor > Config.Tower.FLOORS then
		return nil
	end
	if floor > profile.reached then
		return nil
	end
	local key = tostring(floor)
	local crowns, cash = Rules.floorReward(profile, floor)
	local first = not profile.floors[key]
	if first then
		profile.floors[key] = true
		profile.stats.floorsCleared += 1
		if floor == Config.Tower.FLOORS then
			crowns += Config.Obby.SUMMIT_BONUS_CROWNS
		end
		profile.crowns += crowns
	else
		crowns = 0
		cash = math.floor(cash * Config.Obby.REPEAT_FRACTION)
	end
	Rules.addCash(profile, cash)
	return { first = first, crowns = crowns, cash = cash, unlocks = Rules.unlocks(profile) }
end

-- Move the respawn checkpoint to any floor already reached (replaying / returning). Free.
function Rules.gotoFloor(profile, floor: any): boolean
	if type(floor) ~= "number" or floor ~= math.floor(floor) or floor < 1 or floor > profile.reached then
		return false
	end
	profile.checkpoint = floor
	return true
end

function Rules.skipCost(floor: number): number
	return Config.Obby.SKIP_BASE * floor * floor
end

-- Pay to move your checkpoint to the next floor without earning rewards.
function Rules.skipFloor(profile): (boolean, string)
	local floor = profile.checkpoint
	if floor >= Config.Tower.FLOORS then
		return false, "top"
	end
	local cost = Rules.skipCost(floor)
	if profile.cash < cost then
		return false, "funds"
	end
	profile.cash -= cost
	profile.reached = math.max(profile.reached, floor + 1)
	profile.checkpoint = floor + 1
	profile.stats.skips += 1
	return true, "ok"
end

-- ===== perks / cosmetics / stats =====
function Rules.buyPerk(profile, id: any): (boolean, string)
	if type(id) ~= "string" or not perkById[id] then
		return false, "invalid"
	end
	if profile.perks[id] then
		return false, "owned"
	end
	local p = perkById[id]
	if profile.cash < p.cost then
		return false, "funds"
	end
	profile.cash -= p.cost
	profile.perks[id] = true
	return true, "ok"
end

function Rules.equipTrail(profile, id: any): boolean
	if id == "" then
		profile.trail = ""
		return true
	end
	if type(id) ~= "string" or not profile.trails[id] then
		return false
	end
	profile.trail = id
	return true
end

function Rules.equipAura(profile, id: any): boolean
	if id == "" then
		profile.aura = ""
		return true
	end
	if type(id) ~= "string" or not profile.auras[id] then
		return false
	end
	profile.aura = id
	return true
end

-- final movement stats from perks
function Rules.movement(profile)
	local walk, jump, double, magnet = 16, 50, false, 0
	for id in profile.perks do
		local p = perkById[id]
		if p then
			walk = math.max(walk, p.walk or 0)
			jump = math.max(jump, p.jump or 0)
			double = double or p.double == true
			magnet = math.max(magnet, p.magnet or 0)
		end
	end
	return { walk = walk, jump = jump, double = double, magnet = magnet }
end

-- ===== objective hint =====
function Rules.nextObjective(profile)
	local nxt = Rules.nextItem(profile)
	if Rules.canOverdrive(profile) then
		return { kind = "overdrive", text = "Your Overdrive Reactor is ready. Trigger Overdrive for a permanent income boost." }
	end
	local floor = profile.reached
	if not profile.floors[tostring(floor)] then
		if nxt and profile.cash >= Rules.itemCost(nxt, profile) and Rules.canBuyItem(profile, nxt.id) then
			return { kind = "buy", text = ("Buy %s in your factory (%s)."):format(nxt.name, tostring(Rules.itemCost(nxt, profile))) }
		end
		return { kind = "climb", text = ("Climb the tower: clear floor %d (%s)."):format(floor, Config.Floors[floor].name) }
	end
	if floor < Config.Tower.FLOORS then
		return { kind = "climb", text = ("Floor %d cleared! Take the next checkpoint to start floor %d."):format(floor, floor + 1) }
	end
	return { kind = "done", text = "You conquered the tower. Push your factory to Overdrive." }
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- DataStore persistence.
--  * Session lock (UpdateAsync) so two servers can never write the same profile at once.
--  * Bounded retries with exponential backoff for every DataStore call.
--  * A profile is only ever saved if it was successfully LOADED by this server: a failed load kicks the player
--    instead of handing them a blank profile that would overwrite their real data.
--  * Autosave, save-on-leave (PlayerRemoving) and save-everything on shutdown (BindToClose).
--  * In Studio without API access an in-memory fallback is used with a loud warning.
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Profile = require(Shared.Profile)

local DataService = {}

local STORE_NAME = "Neonforge_Profiles_v1"
local LOCK_TIMEOUT = 120 -- seconds before another server's lock is treated as dead
local MAX_ATTEMPTS = 5
local LOAD_ROUNDS = 6

local store: DataStore? = nil
local offline = false
local memory: { [number]: any } = {}
local loaded: { [Player]: any } = {} -- profiles safe to save
local saving: { [Player]: boolean } = {} -- one save per player at a time

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function getStore(): DataStore?
	if offline then
		return nil
	end
	if not store then
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(STORE_NAME)
		end)
		if ok then
			store = result
		else
			if RunService:IsStudio() then
				warn("[Neonforge] DataStore unavailable in Studio - progress will NOT be saved. Enable 'Enable Studio Access to API Services'.")
				offline = true
				return nil
			end
			error(result)
		end
	end
	return store
end

local function withRetry(fn: () -> any): (boolean, any)
	local lastErr
	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		if RunService:IsStudio() and tostring(result):find("StudioAccessToApisNotAllowed") then
			warn("[Neonforge] DataStore API access disabled in Studio - using in-memory profiles (nothing will persist).")
			offline = true
			return false, "offline"
		end
		warn(("[Neonforge] DataStore attempt %d/%d failed: %s"):format(attempt, MAX_ATTEMPTS, tostring(result)))
		task.wait(2 ^ attempt * 0.5)
	end
	return false, lastErr
end

local function lockedByOther(lock: any): boolean
	return type(lock) == "table" and lock.jobId ~= game.JobId and os.time() - (lock.t or 0) < LOCK_TIMEOUT
end

-- Returns a reconciled profile, or nil + reason. Never returns a blank profile after a failed load.
function DataService.load(player: Player): (any?, string?)
	local ds = getStore()
	if not ds then
		local p = Profile.reconcile(memory[player.UserId])
		loaded[player] = p
		return p
	end
	local key = keyFor(player.UserId)
	for _ = 1, LOAD_ROUNDS do
		local blocked = false
		local ok, data = withRetry(function()
			return ds:UpdateAsync(key, function(old)
				old = old or {}
				if lockedByOther(old.lock) then
					blocked = true
					return nil -- cancel the write
				end
				old.lock = { jobId = game.JobId, t = os.time() }
				return old
			end)
		end)
		if offline then
			local p = Profile.reconcile(nil)
			loaded[player] = p
			return p
		end
		if not ok then
			return nil, "DataStore error: " .. tostring(data)
		end
		if blocked then
			task.wait(5) -- the previous server is probably still saving on leave
		else
			local p = Profile.reconcile(data and data.data)
			loaded[player] = p
			return p
		end
	end
	return nil, "Your data is still in use by another server. Please rejoin in a minute."
end

function DataService.get(player: Player): any?
	return loaded[player]
end

-- Saves a profile that this server loaded. release=true clears the session lock (leaving).
function DataService.save(player: Player, release: boolean?): boolean
	local profile = loaded[player]
	if not profile then
		return false -- never save a profile we did not load
	end
	if saving[player] then
		if not release then
			return false -- another save is already in flight; the next autosave covers it
		end
		-- a final save must not be dropped: wait for the in-flight save, then write the latest data and free the lock
		local t0 = os.clock()
		while saving[player] and os.clock() - t0 < 30 do
			task.wait(0.1)
		end
		if saving[player] then
			return false
		end
	end
	saving[player] = true
	local ds = getStore()
	if not ds then
		memory[player.UserId] = Profile.reconcile(profile)
		saving[player] = nil
		return true
	end
	-- snapshot now so the table we write cannot change mid-request
	local snapshot = Profile.reconcile(profile)
	local ok, err = withRetry(function()
		return ds:UpdateAsync(keyFor(player.UserId), function(old)
			old = old or {}
			if lockedByOther(old.lock) then
				return nil -- another server owns this profile now; do not clobber it
			end
			old.data = snapshot
			old.lock = if release then nil else { jobId = game.JobId, t = os.time() }
			return old
		end)
	end)
	saving[player] = nil
	if not ok and not offline then
		warn("[Neonforge] Save failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

-- Call after the final save when a player leaves.
function DataService.release(player: Player)
	loaded[player] = nil
	saving[player] = nil
end

-- Autosave all loaded players (staggered so we do not burst the DataStore budget).
function DataService.startAutosave(interval: number)
	task.spawn(function()
		while true do
			task.wait(interval)
			local list = {}
			for player in loaded do
				table.insert(list, player)
			end
			for _, player in list do
				if player.Parent then
					task.spawn(DataService.save, player, false)
				end
				task.wait(1)
			end
		end
	end)
end

function DataService.saveAllBlocking()
	local pending = 0
	for player in loaded do
		pending += 1
		task.spawn(function()
			DataService.save(player, true)
			pending -= 1
		end)
	end
	local t0 = os.clock()
	while pending > 0 and os.clock() - t0 < 25 do
		task.wait(0.2)
	end
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- NEONFORGE server entry point. Boot: remotes -> world dressing -> services -> players.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Server = script.Parent
local DataService = require(Server.DataService)
local Sessions = require(Server.Sessions)
local StateService = require(Server.StateService)
local ProgressService = require(Server.ProgressService)
local PlotService = require(Server.PlotService)
local TycoonService = require(Server.TycoonService)
local ObbyService = require(Server.ObbyService)
local ShopService = require(Server.ShopService)
local WorldSetup = require(Server.WorldSetup)
local RateLimit = require(Server.RateLimit)

Players.RespawnTime = 2.5

Remotes.create()
local world = Workspace:WaitForChild("World", 30)
if not world then
	error("[Neonforge] Workspace.World is missing: build the place with Rojo (world/World.rbxm)")
end
WorldSetup.run(world)
PlotService.init(world)
StateService.start()
TycoonService.start()
ShopService.start()
local counts = ObbyService.start(world)
print(("[Neonforge] tower behaviours: %d movers, %d spinners, %d lasers, %d vanish, %d bounce, %d speed, %d belts, %d coins"):format(
	counts.mover, counts.spinner, counts.laser, counts.vanish, counts.bounce, counts.speed, counts.belt, counts.coin))
DataService.startAutosave(60)

-- Remote events fired before the client connected a handler are lost, so the initial state is sent only once BOTH the
-- session exists (data loaded) and the client said it is ready.
local clientReady: { [Player]: boolean } = {}

Remotes.get("ClientReady").OnServerEvent:Connect(function(player: Player)
	if not RateLimit.allow(player, "ready", 0.5, 3) then
		return
	end
	clientReady[player] = true
	local session = Sessions.get(player)
	if session then
		session.ready = true
		StateService.pushNow(session)
	end
end)

local function onPlayerAdded(player: Player)
	local profile, err = DataService.load(player)
	if not profile then
		if player.Parent then
			player:Kick("Could not load your save data (" .. tostring(err) .. "). Your progress is safe - please rejoin in a minute.")
		end
		return
	end
	if not player.Parent then
		DataService.save(player, true) -- left while loading: free the session lock, never touch the data
		DataService.release(player)
		return
	end
	local session = Sessions.create(player, profile)
	session.ready = clientReady[player] == true
	if not PlotService.claim(session) then
		StateService.notify(player, { kind = "msg", text = "All plots are taken on this server. You can still climb the tower!", tone = "warn" })
	end
	player.CharacterAdded:Connect(function(char)
		ObbyService.onCharacter(session, char)
	end)
	if player.Character then
		task.spawn(ObbyService.onCharacter, session, player.Character)
	end
	ProgressService.commit(session)
	StateService.pushNow(session)
end

local function onPlayerRemoving(player: Player)
	local session = Sessions.get(player)
	if session then
		PlotService.release(session)
		StateService.forget(session)
		session.profile.stats.playSeconds += math.floor(os.clock() - session.loadedAt)
	end
	clientReady[player] = nil
	DataService.save(player, true) -- final save; clears the session lock
	DataService.release(player)
	Sessions.remove(player)
	RateLimit.forget(player)
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(onPlayerAdded, player)
end)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

game:BindToClose(function()
	if RunService:IsStudio() then
		task.wait(0.5)
	end
	DataService.saveAllBlocking()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Mk</string>
          <string name="Source"><![CDATA[-- Runtime part construction helpers (server). Everything is anchored; decorative parts are not queryable.
local Mk = {}

local function col(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end
Mk.color = col

function Mk.part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: { number }, material: string?, o: any?): Part
	o = o or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = o.collide == true
	p.CanTouch = o.touch == true
	p.CanQuery = o.collide == true
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = col(color)
	p.Material = Enum.Material[material or "SmoothPlastic"]
	p.Transparency = o.tr or 0
	if o.shape then
		p.Shape = Enum.PartType[o.shape]
	end
	if o.spin then
		p:SetAttribute("Spin", o.spin)
	end
	if o.bob then
		p:SetAttribute("Bob", o.bob)
	end
	p.Parent = parent
	return p
end

-- vertical cylinder (Roblox cylinders run along X)
function Mk.cyl(parent: Instance, name: string, height: number, diameter: number, cf: CFrame, color: { number }, material: string?, o: any?): Part
	return Mk.part(parent, name, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material, (function()
		local t = table.clone(o or {})
		t.shape = "Cylinder"
		return t
	end)())
end

function Mk.ball(parent: Instance, name: string, d: number, cf: CFrame, color: { number }, material: string?, o: any?): Part
	local t = table.clone(o or {})
	t.shape = "Ball"
	return Mk.part(parent, name, Vector3.new(d, d, d), cf, color, material, t)
end

function Mk.label(adornee: BasePart, text: string, offsetY: number, color: { number }?, size: UDim2?, maxDistance: number?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = size or UDim2.fromOffset(220, 44)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance or 160
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local l = Instance.new("TextLabel")
	l.Name = "Text"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = col(color or { 255, 255, 255 })
	l.TextStrokeTransparency = 0.4
	l.Parent = gui
	gui.Parent = adornee
	return gui
end

function Mk.light(parent: Instance, color: { number }, range: number, brightness: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = col(color)
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	return l
end

return Mk
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Obby</string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Behaviors</string>
            <string name="Source"><![CDATA[-- Applies behaviour to baked tower parts according to their names (see tools/bake/Modules.luau for the grammar):
--   Kill | SpinnerKill:speed | Turntable:speed | KillMover:vx,vy,vz:period:phase | Mover:vx,vy,vz:period:phase |
--   Piston:dy:period:offset | Laser:on,off,offset | Vanish:delay | Bounce:power | Speed:mult:seconds |
--   Belt:vx,vy,vz | Coin
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Behaviors = {}

local function humanoidOf(hit: BasePart): (Humanoid?, Player?)
	local model = hit.Parent
	if not model then
		return nil, nil
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return nil, nil
	end
	return hum, Players:GetPlayerFromCharacter(model)
end

local function vec(s: string): Vector3
	local x, y, z = s:match("^(%-?[%d%.]+),(%-?[%d%.]+),(%-?[%d%.]+)$")
	return Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
end

local function startMover(part: BasePart, offset: Vector3, period: number, phase: number)
	local base = part.CFrame
	local info = TweenInfo.new(math.max(0.2, period / 2), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local tween = TweenService:Create(part, info, { CFrame = base + offset })
	if phase > 0 then
		part.CFrame = base
		task.delay(phase, function()
			tween:Play()
		end)
	else
		tween:Play()
	end
end

-- motor-driven rotation around the world's up axis (works for bars and cylinders whatever their local axes)
local function makeSpinner(part: BasePart, speed: number)
	local pivot = Instance.new("Part")
	pivot.Name = "SpinPivot"
	pivot.Anchored = true
	pivot.CanCollide = false
	pivot.CanTouch = false
	pivot.CanQuery = false
	pivot.Transparency = 1
	pivot.Size = Vector3.new(1, 1, 1)
	pivot.CFrame = part.CFrame
	pivot.Parent = part.Parent
	local axisLocal = part.CFrame:VectorToObjectSpace(Vector3.yAxis)
	local attCF = CFrame.lookAt(Vector3.zero, axisLocal) * CFrame.Angles(0, math.pi / 2, 0)
	local a0 = Instance.new("Attachment")
	a0.CFrame = attCF
	a0.Parent = pivot
	local a1 = Instance.new("Attachment")
	a1.CFrame = attCF
	a1.Parent = part
	local hinge = Instance.new("HingeConstraint")
	hinge.Attachment0 = a0
	hinge.Attachment1 = a1
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = speed
	hinge.MotorMaxTorque = 1e9
	hinge.Parent = part
	part.Anchored = false
	part:SetNetworkOwner(nil) -- server simulates it, so every player sees the same rotation
end

function Behaviors.apply(root: Instance, hooks: any)
	local lasers = {}
	local counts = { kill = 0, mover = 0, spinner = 0, laser = 0, vanish = 0, bounce = 0, speed = 0, belt = 0, coin = 0 }

	local function connectKill(part: BasePart, gate: (() -> boolean)?)
		local last: { [Humanoid]: number } = {}
		part.Touched:Connect(function(hit)
			if gate and not gate() then
				return
			end
			local hum, player = humanoidOf(hit)
			if hum and hum.Health > 0 then
				local now = os.clock()
				if now - (last[hum] or 0) > 0.4 then
					last[hum] = now
					hooks.kill(hum, player)
				end
			end
		end)
		counts.kill += 1
	end

	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			local name = d.Name
			local kind = name:match("^([A-Za-z]+)")
			local args = name:split(":")
			if kind == "Kill" then
				connectKill(d)
			elseif kind == "SpinnerKill" then
				makeSpinner(d, tonumber(args[2]) or 1)
				connectKill(d)
				counts.spinner += 1
			elseif kind == "Turntable" then
				makeSpinner(d, tonumber(args[2]) or 0.5)
				counts.spinner += 1
			elseif kind == "KillMover" or kind == "Mover" then
				startMover(d, vec(args[2] or ""), tonumber(args[3]) or 3, tonumber(args[4]) or 0)
				if kind == "KillMover" then
					connectKill(d)
				end
				counts.mover += 1
			elseif kind == "Piston" then
				startMover(d, Vector3.new(0, tonumber(args[2]) or -6, 0), tonumber(args[3]) or 2.4, tonumber(args[4]) or 0)
				connectKill(d)
				counts.mover += 1
			elseif kind == "Laser" then
				local on, off, offset = (args[2] or ""):match("^([%d%.]+),([%d%.]+),([%d%.]+)$")
				local laser = { part = d, on = tonumber(on) or 1, off = tonumber(off) or 1, offset = tonumber(offset) or 0, active = true }
				table.insert(lasers, laser)
				connectKill(d, function()
					return laser.active
				end)
				counts.laser += 1
			elseif kind == "Vanish" then
				local delay = tonumber(args[2]) or 0.8
				local busy = false
				d.Touched:Connect(function(hit)
					if busy or not humanoidOf(hit) then
						return
					end
					busy = true
					task.delay(delay, function()
						TweenService:Create(d, TweenInfo.new(0.25), { Transparency = 1 }):Play()
						task.delay(0.25, function()
							d.CanCollide = false
						end)
						task.delay(3.2, function()
							d.Transparency = 0
							d.CanCollide = true
							busy = false
						end)
					end)
				end)
				counts.vanish += 1
			elseif kind == "Bounce" then
				local power = tonumber(args[2]) or 100
				local last = 0
				d.Touched:Connect(function(hit)
					local hum, player = humanoidOf(hit)
					if hum and player and os.clock() - last > 0.6 then
						last = os.clock()
						hooks.bounce(player, power)
					end
				end)
				counts.bounce += 1
			elseif kind == "Speed" then
				local mult, secs = tonumber(args[2]) or 1.8, tonumber(args[3]) or 3
				local last = 0
				d.Touched:Connect(function(hit)
					local hum, player = humanoidOf(hit)
					if hum and player and os.clock() - last > 0.5 then
						last = os.clock()
						hooks.speed(player, mult, secs)
					end
				end)
				counts.speed += 1
			elseif kind == "Belt" then
				d.AssemblyLinearVelocity = vec(args[2] or "")
				counts.belt += 1
			elseif kind == "Coin" then
				d.Touched:Connect(function(hit)
					local hum, player = humanoidOf(hit)
					if hum and player then
						hooks.coin(player, d)
					end
				end)
				counts.coin += 1
			end
		end
	end

	if #lasers > 0 then
		RunService.Heartbeat:Connect(function()
			local t = Workspace:GetServerTimeNow()
			for _, l in lasers do
				local cycle = l.on + l.off
				local want = ((t + l.offset) % cycle) < l.on
				if want ~= l.active then
					l.active = want
					l.part.Transparency = if want then 0.1 else 1
				end
			end
		end)
	end
	return counts
end

return Behaviors
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ObbyService</string>
          <string name="Source"><![CDATA[-- The tower: checkpoints, floor rewards, respawning, teleports, coins, bounce / speed pads and fall recovery.
-- Progress rules live in shared/Rules; this module adds the physical-world checks (touching, timing, distance).
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Remotes)
local Sessions = require(script.Parent.Sessions)
local StateService = require(script.Parent.StateService)
local ProgressService = require(script.Parent.ProgressService)
local PlotService = require(script.Parent.PlotService)
local RateLimit = require(script.Parent.RateLimit)
local Behaviors = require(script.Parent.Obby.Behaviors)

local ObbyService = {}

local T = Config.Tower
local pads: { [number]: BasePart } = {} -- checkpoint pads by floor (13 = summit)
local coins: { { part: BasePart, floor: number, taken: boolean } } = {}
local hubSpawn: CFrame = CFrame.new(0, 5, -136)

local function rootOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not hrp or not hrp:IsA("BasePart") then
		return nil
	end
	return hrp
end

local function padCFrame(floor: number): CFrame?
	local pad = pads[floor]
	if not pad then
		return nil
	end
	return pad.CFrame + Vector3.new(0, 5, 0)
end

-- where this player should stand right now
function ObbyService.targetCFrame(session: Sessions.Session): CFrame
	if session.inTower then
		local cf = padCFrame(session.profile.checkpoint)
		if cf then
			return cf
		end
	end
	if session.plot then
		return PlotService.spawnCFrame(session.plot)
	end
	return hubSpawn + Vector3.new(0, 3, 0)
end

function ObbyService.place(session: Sessions.Session)
	local char = session.player.Character
	local hrp = rootOf(session.player)
	if not char or not hrp then
		return
	end
	hrp.AssemblyLinearVelocity = Vector3.zero
	char:PivotTo(ObbyService.targetCFrame(session))
end

local function setMoveSpeed(session: Sessions.Session)
	ProgressService.applyCharacter(session)
end

-- ===== checkpoints / floors =====
local function onCheckpoint(player: Player, floor: number, pad: BasePart)
	local session = Sessions.get(player)
	local hrp = rootOf(player)
	if not session or not hrp then
		return
	end
	if not RateLimit.allow(player, "checkpoint", 4, 6) then
		return
	end
	if (hrp.Position - pad.Position).Magnitude > Config.Obby.CHECKPOINT_REACH_RADIUS then
		return
	end
	local p = session.profile
	local now = os.clock()
	session.inTower = true
	if floor == session.lastCheckpoint then
		if floor <= p.reached then
			Rules.gotoFloor(p, floor)
		end
		return
	end
	local events = {}
	if floor >= 2 and floor == session.lastCheckpoint + 1 then
		if now - session.checkpointAt < T.MIN_FLOOR_SECONDS then
			StateService.notify(player, { kind = "msg", text = "Too fast! That floor cannot be cleared this quickly.", tone = "warn" })
			return
		end
		if not Rules.reachFloor(p, floor) then
			return
		end
		local res = Rules.clearFloor(p, floor - 1)
		if res then
			table.insert(events, { kind = "floorClear", floor = floor - 1, name = Config.Floors[floor - 1].name, crowns = res.crowns, cash = res.cash, first = res.first })
		end
	elseif floor <= p.reached then
		Rules.gotoFloor(p, floor) -- arriving at a checkpoint you already unlocked (no rewards)
	else
		StateService.notify(player, { kind = "msg", text = "Climb the floors in order to unlock this checkpoint.", tone = "warn" })
		return
	end
	session.lastCheckpoint = floor
	session.checkpointAt = now
	table.insert(events, { kind = "checkpoint", floor = floor, name = Config.Floors[floor].name })
	ProgressService.commit(session, events)
end

local function onSummit(player: Player, pad: BasePart)
	local session = Sessions.get(player)
	local hrp = rootOf(player)
	if not session or not hrp or not RateLimit.allow(player, "checkpoint", 4, 6) then
		return
	end
	if (hrp.Position - pad.Position).Magnitude > Config.Obby.CHECKPOINT_REACH_RADIUS then
		return
	end
	local p = session.profile
	if session.lastCheckpoint ~= T.FLOORS or os.clock() - session.checkpointAt < T.MIN_FLOOR_SECONDS or p.reached < T.FLOORS then
		return
	end
	local res = Rules.clearFloor(p, T.FLOORS)
	session.lastCheckpoint = T.FLOORS + 1
	if res then
		ProgressService.commit(session, { { kind = "floorClear", floor = T.FLOORS, name = Config.Floors[T.FLOORS].name, crowns = res.crowns, cash = res.cash, first = res.first, summit = true } })
	end
end

-- ===== teleports =====
local function teleportCooldown(session: Sessions.Session): boolean
	local now = os.clock()
	if now - session.lastGoto < 1.5 then
		return false
	end
	session.lastGoto = now
	return true
end

function ObbyService.goTower(session: Sessions.Session)
	session.inTower = true
	session.lastCheckpoint = session.profile.checkpoint
	session.checkpointAt = os.clock()
	ObbyService.place(session)
	ProgressService.commit(session)
end

function ObbyService.goHome(session: Sessions.Session)
	session.inTower = false
	session.lastCheckpoint = 0
	ObbyService.place(session)
	ProgressService.commit(session)
end

-- ===== characters =====
function ObbyService.onCharacter(session: Sessions.Session, character: Model)
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	if not hum or not hrp then
		return
	end
	hum.MaxSlopeAngle = 60
	ProgressService.applyCharacter(session)
	ObbyService.place(session)
	hum.Died:Connect(function()
		if session.inTower then
			session.profile.stats.deaths += 1
			StateService.notify(session.player, { kind = "death" })
			StateService.markDirty(session)
		end
	end)
end

-- ===== hooks used by the behaviours =====
local hooks = {}

function hooks.kill(hum: Humanoid, player: Player?)
	hum.Health = 0
end

function hooks.bounce(player: Player, power: number)
	Remotes.get("Launch"):FireClient(player, power)
	StateService.notify(player, { kind = "fx", what = "bounce" })
end

function hooks.speed(player: Player, mult: number, secs: number)
	local session = Sessions.get(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not session or not hum then
		return
	end
	session.boostToken += 1
	local token = session.boostToken
	hum.WalkSpeed = Rules.movement(session.profile).walk * mult
	StateService.notify(player, { kind = "fx", what = "speed", seconds = secs })
	task.delay(secs, function()
		if session.boostToken == token then
			setMoveSpeed(session)
		end
	end)
end

local function floorAtHeight(y: number): number
	local per = T.MODULES_PER_FLOOR * T.RISE_PER_MODULE
	return math.clamp(math.floor((y - T.BASE_Y + 3) / per) + 1, 1, T.FLOORS)
end

local function collect(session: Sessions.Session, coin)
	if coin.taken then
		return
	end
	coin.taken = true
	coin.part.Transparency = 1
	coin.part.CanTouch = false
	local cash = Config.Obby.COIN_CASH * coin.floor * math.max(1, session.profile.overdrive + 1)
	Rules.addCash(session.profile, cash)
	session.profile.stats.coins += 1
	StateService.notify(session.player, { kind = "coin", cash = cash })
	StateService.markDirty(session)
	task.delay(25, function()
		coin.taken = false
		coin.part.Transparency = 0
		coin.part.CanTouch = true
	end)
end

function hooks.coin(player: Player, part: BasePart)
	local session = Sessions.get(player)
	if not session then
		return
	end
	for _, c in coins do
		if c.part == part then
			collect(session, c)
			return
		end
	end
end

-- ===== start =====
function ObbyService.start(world: Instance)
	local tower = world:WaitForChild("Tower")
	local counts = Behaviors.apply(tower, hooks)
	for _, d in tower:GetDescendants() do
		if d:IsA("BasePart") then
			local f = d.Name:match("^Checkpoint:(%d+)$")
			if f then
				local floor = tonumber(f) :: number
				pads[floor] = d
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						onCheckpoint(player, floor, d)
					end
				end)
			elseif d.Name == "Summit" then
				pads[T.FLOORS + 1] = d
				d.Touched:Connect(function(hit)
					local player = Players:GetPlayerFromCharacter(hit.Parent)
					if player then
						onSummit(player, d)
					end
				end)
			elseif d.Name == "Coin" then
				table.insert(coins, { part = d, floor = floorAtHeight(d.Position.Y), taken = false })
			end
		end
	end
	local hs = world:FindFirstChild("Marker:HubSpawn", true) :: BasePart?
	if hs then
		hubSpawn = hs.CFrame
	end

	Remotes.get("Teleport").OnServerInvoke = function(player: Player, where: any)
		local session = Sessions.get(player)
		if not session or not RateLimit.allow(player, "tp", 2, 3) then
			return { ok = false }
		end
		if where ~= "tower" and where ~= "home" then
			return { ok = false }
		end
		if not teleportCooldown(session) then
			return { ok = false, reason = "cooldown" }
		end
		if where == "tower" then
			ObbyService.goTower(session)
		else
			ObbyService.goHome(session)
		end
		return { ok = true }
	end
	Remotes.get("GotoFloor").OnServerInvoke = function(player: Player, floor: any)
		local session = Sessions.get(player)
		if not session or not RateLimit.allow(player, "tp", 2, 3) then
			return { ok = false }
		end
		local valid = type(floor) == "number" and floor == math.floor(floor) and floor >= 1 and floor <= session.profile.reached
		if not valid then
			return { ok = false, reason = "locked" }
		end
		if not teleportCooldown(session) then
			return { ok = false, reason = "cooldown" }
		end
		Rules.gotoFloor(session.profile, floor)
		ObbyService.goTower(session)
		return { ok = true }
	end
	Remotes.get("Skip").OnServerInvoke = function(player: Player)
		local session = Sessions.get(player)
		if not session or not RateLimit.allow(player, "skip", 1, 2) then
			return { ok = false }
		end
		local ok, reason = Rules.skipFloor(session.profile)
		if not ok then
			return { ok = false, reason = reason }
		end
		ObbyService.goTower(session)
		StateService.notify(player, { kind = "msg", text = ("Skipped to floor %d."):format(session.profile.checkpoint), tone = "good" })
		return { ok = true }
	end

	-- every 0.4 s: fall recovery, out-of-bounds and coin magnet
	task.spawn(function()
		while true do
			task.wait(0.4)
			for _, session in Sessions.all() do
				local hrp = rootOf(session.player)
				if hrp then
					local pos = hrp.Position
					if session.inTower then
						local pad = pads[session.profile.checkpoint]
						if pad and (pos.Y < pad.Position.Y - T.FALL_MARGIN or pos.Y < -150) then
							ObbyService.place(session)
						end
						local mg = Rules.movement(session.profile).magnet
						if mg > 0 then
							for _, c in coins do
								if not c.taken and (c.part.Position - pos).Magnitude <= mg then
									collect(session, c)
								end
							end
						end
					elseif pos.Y < -60 or pos.Magnitude > 3000 then
						ObbyService.place(session)
					end
				end
			end
		end
	end)
	return counts
end

return ObbyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- Plot ownership + factory construction. The baked world contains eight empty plots with marker parts; machines are
-- built here when a player claims a plot and as they buy pieces.
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Mk = require(script.Parent.Mk)
local Factory = require(script.Parent.Plots.Factory)
local Sessions = require(script.Parent.Sessions)

local PlotService = {}
PlotService.onPad = nil :: ((number, BasePart) -> ())? -- set by TycoonService: a part touched the buy pad of plot n
PlotService.onOverdrive = nil :: ((Player) -> ())?

type Plot = { index: number, origin: CFrame, sign: BasePart, spawn: CFrame, folder: Folder, pad: BasePart?, owner: Player?, label: BillboardGui? }
local plots: { Plot } = {}
local factories: Folder

function PlotService.init(world: Instance)
	factories = Instance.new("Folder")
	factories.Name = "Factories"
	factories.Parent = Workspace
	local plotsFolder = world:WaitForChild("Plots")
	for i = 1, Config.Plots.COUNT do
		local pf = plotsFolder:WaitForChild("Plot" .. i)
		local origin = pf:WaitForChild("Marker:PlotOrigin:" .. i) :: BasePart
		local sign = pf:WaitForChild("Marker:PlotSign:" .. i) :: BasePart
		local sp = pf:WaitForChild("Marker:PlotSpawn:" .. i) :: BasePart
		local folder = Instance.new("Folder")
		folder.Name = "Plot" .. i
		folder:SetAttribute("Origin", origin.CFrame) -- the client draws ores relative to this
		folder.Parent = factories
		plots[i] = { index = i, origin = origin.CFrame, sign = sign, spawn = sp.CFrame, folder = folder, pad = nil, owner = nil, label = nil }
	end
end

function PlotService.get(i: number): Plot?
	return plots[i]
end

function PlotService.all(): { Plot }
	return plots
end

local function clear(plot: Plot)
	plot.folder:ClearAllChildren()
	plot.pad = nil
	if plot.label then
		plot.label:Destroy()
		plot.label = nil
	end
end

local function itemList(profile)
	local out = {}
	for _, it in Config.Items do
		if profile.items[it.id] then
			table.insert(out, it)
		end
	end
	return out
end

local function hook(plot: Plot, model: Instance)
	for _, d in model:GetDescendants() do
		if d:IsA("ProximityPrompt") and d:GetAttribute("Action") == "overdrive" then
			d.Triggered:Connect(function(player)
				if plot.owner == player and PlotService.onOverdrive then
					PlotService.onOverdrive(player)
				end
			end)
		end
	end
end

function PlotService.build(plot: Plot, profile: any)
	clear(plot)
	local O = plot.origin
	Factory.buildBelt(plot.folder, O)
	local pad = Factory.buildPad(plot.folder, O)
	plot.pad = pad
	pad.Touched:Connect(function(hit)
		if PlotService.onPad then
			PlotService.onPad(plot.index, hit)
		end
	end)
	for _, it in itemList(profile) do
		hook(plot, Factory.buildItem(plot.folder, O, it))
	end
end

function PlotService.addItem(plot: Plot, item: any)
	hook(plot, Factory.buildItem(plot.folder, plot.origin, item))
end

-- the pad shows what to buy next
function PlotService.updatePad(plot: Plot, profile: any)
	if not plot.pad then
		return
	end
	local old = plot.pad:FindFirstChild("Label")
	if old then
		old:Destroy()
	end
	local nxt = Rules.nextItem(profile)
	local text, color
	if nxt then
		text = ("%s\n$%s"):format(nxt.name, tostring(Rules.itemCost(nxt, profile)))
		color = { 70, 240, 255 }
	else
		text, color = "Factory complete!", { 255, 215, 90 }
	end
	Mk.label(plot.pad, text, 5, color, UDim2.fromOffset(300, 80), 160)
end

function PlotService.claim(session: Sessions.Session): Plot?
	for _, plot in plots do
		if not plot.owner then
			plot.owner = session.player
			session.plot = plot.index
			session.player:SetAttribute("Plot", plot.index)
			PlotService.build(plot, session.profile)
			PlotService.updatePad(plot, session.profile)
			local lbl = Mk.label(plot.sign, ("%s's Factory"):format(session.player.DisplayName), 0, Config.Colors.cyan, UDim2.fromOffset(520, 90), 400)
			plot.label = lbl
			return plot
		end
	end
	return nil
end

function PlotService.release(session: Sessions.Session)
	local i = session.plot
	if i and plots[i] and plots[i].owner == session.player then
		plots[i].owner = nil
		clear(plots[i])
	end
	session.plot = nil
end

function PlotService.spawnCFrame(plotIndex: number): CFrame
	return plots[plotIndex].spawn + Vector3.new(0, 3, 0)
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Plots</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Factory</string>
            <string name="Source"><![CDATA[-- Builds the machines of one tycoon plot. Plot-local axes: +X along the belt, -Z towards the tower.
-- Ores are NOT parts: the client draws them from the same deterministic schedule the server uses for income.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Mk = require(script.Parent.Parent.Mk)

local Factory = {}

local BELT_Y = Config.Plots.BELT_Y
Factory.BELT_X0, Factory.BELT_X1 = -38, 38

local function dark(c, k)
	return { c[1] * k, c[2] * k, c[3] * k }
end

-- the belt itself (always present)
function Factory.buildBelt(folder: Instance, O: CFrame)
	local m = Instance.new("Model")
	m.Name = "Belt"
	local function L(x, y, z) return O * CFrame.new(x, y, z) end
	Mk.part(m, "Belt", Vector3.new(76, 0.8, 8), L(0, BELT_Y - 0.4, 0), { 40, 36, 60 }, "DiamondPlate", { collide = true })
	for _, z in { -4.3, 4.3 } do
		Mk.part(m, "Rail", Vector3.new(76, 1.2, 0.7), L(0, BELT_Y + 0.2, z), { 70, 240, 255 }, "Neon")
	end
	for x = -36, 36, 12 do
		Mk.part(m, "Leg", Vector3.new(1.4, BELT_Y, 1.4), L(x, BELT_Y / 2 - 0.4, 3.2), { 60, 52, 90 }, "Metal")
		Mk.part(m, "Leg", Vector3.new(1.4, BELT_Y, 1.4), L(x, BELT_Y / 2 - 0.4, -3.2), { 60, 52, 90 }, "Metal")
	end
	for x = -34, 34, 4 do
		Mk.part(m, "Chevron", Vector3.new(1.6, 0.1, 3), L(x, BELT_Y + 0.05, 0), { 255, 215, 90 }, "Neon", { tr = 0.35 })
	end
	m.Parent = folder
	return m
end

local builders: { [string]: (Instance, CFrame, any) -> () } = {}

builders.dropper = function(m, O, it)
	local function L(x, y, z) return O * CFrame.new(x, y, z) end
	local x = it.x
	for _, z in { -3.4, 3.4 } do
		Mk.part(m, "Post", Vector3.new(1, 14, 1), L(x, 7 + BELT_Y, z), { 60, 52, 90 }, "Metal", { collide = true })
	end
	Mk.part(m, "Top", Vector3.new(7, 1.6, 9), L(x, 14.8 + BELT_Y, 0), dark(it.color, 0.55), "Metal", { collide = true })
	Mk.cyl(m, "Funnel", 3.4, 5.4, L(x, 12.2 + BELT_Y, 0), dark(it.color, 0.7), "Metal")
	Mk.cyl(m, "Nozzle", 2.4, 1.6, L(x, 9.6 + BELT_Y, 0), { 90, 80, 120 }, "Metal")
	Mk.cyl(m, "Ring", 0.5, 5.9, L(x, 13.6 + BELT_Y, 0), it.color, "Neon")
	Mk.ball(m, "Core", 2.2, L(x, 12.6 + BELT_Y, 0), it.color, "Neon", { bob = 0.3 })
	local plate = Mk.part(m, "Plate", Vector3.new(6, 1.6, 0.4), L(x, 17 + BELT_Y, 0), { 24, 18, 48 }, "SmoothPlastic")
	Mk.label(plate, it.name, 1.6, it.color, UDim2.fromOffset(230, 40), 120)
	Mk.light(m:FindFirstChild("Core") :: Instance, it.color, 14, 1)
end

builders.upgrader = function(m, O, it)
	local function L(x, y, z) return O * CFrame.new(x, y, z) end
	local x = it.x
	for _, z in { -6, 6 } do
		Mk.part(m, "Post", Vector3.new(1.4, 11, 1.4), L(x, 5.5 + BELT_Y, z), { 60, 52, 90 }, "Metal", { collide = true })
		Mk.part(m, "PostGlow", Vector3.new(0.3, 10, 0.3), L(x, 5.5 + BELT_Y, z * 0.9), it.color, "Neon")
	end
	Mk.part(m, "Beam", Vector3.new(1.8, 1.8, 14), L(x, 11.2 + BELT_Y, 0), { 60, 52, 90 }, "Metal")
	Mk.part(m, "Curtain", Vector3.new(0.4, 8.6, 10.6), L(x, 5.4 + BELT_Y, 0), it.color, "Neon", { tr = 0.65 })
	local sign = Mk.part(m, "Sign", Vector3.new(5, 2, 0.5), L(x, 13.4 + BELT_Y, 0), { 24, 18, 48 }, "SmoothPlastic")
	Mk.label(sign, ("x%s"):format(tostring(it.mult)), 1.8, it.color, UDim2.fromOffset(150, 50), 140)
	Mk.part(m, "BeamGlow", Vector3.new(0.4, 0.4, 14.2), L(x, 12.2 + BELT_Y, 0), it.color, "Neon")
end

builders.generator = function(m, O, it)
	local function L(x, y, z) return O * CFrame.new(x, y, z) end
	local x, z = it.x, -16
	Mk.part(m, "Base", Vector3.new(9, 2, 9), L(x, 1, z), { 50, 44, 80 }, "Metal", { collide = true })
	Mk.cyl(m, "Body", 7, 6, L(x, 5.5, z), dark(it.color, 0.5), "Metal", { collide = true })
	Mk.cyl(m, "Rotor", 0.8, 8, L(x, 9.4, z), it.color, "Neon", { spin = 3.2 })
	Mk.ball(m, "Spark", 2.4, L(x, 11.2, z), { 255, 255, 255 }, "Neon", { bob = 0.4 })
	Mk.part(m, "Cable", Vector3.new(0.9, 0.9, math.abs(z) - 4), L(x, 0.7, z / 2 + 2), it.color, "Neon")
	local sign = Mk.part(m, "Sign", Vector3.new(5, 1.4, 0.4), L(x, 14.4, z), { 24, 18, 48 }, "SmoothPlastic")
	Mk.label(sign, ("+%s/s"):format(tostring(it.rate)), 1.6, it.color, UDim2.fromOffset(170, 44), 140)
	Mk.light(m:FindFirstChild("Spark") :: Instance, it.color, 18, 1.4)
end

builders.collector = function(m, O, it)
	local function L(x, y, z) return O * CFrame.new(x, y, z) end
	local gold = it.bonus > 1
	local c = gold and { 255, 205, 80 } or { 90, 255, 150 }
	local x = 35
	local s = gold and 1.25 or 1
	Mk.part(m, "BinFloor", Vector3.new(9 * s, 0.8, 10 * s), L(x, BELT_Y - 0.4, 0), dark(c, 0.4), "Metal", { collide = true })
	for _, z in { -5 * s, 5 * s } do
		Mk.part(m, "BinWall", Vector3.new(9 * s, 5 * s, 0.8), L(x, BELT_Y + 2.5 * s, z), dark(c, 0.55), "Metal", { collide = true })
		Mk.part(m, "BinGlow", Vector3.new(9 * s, 0.4, 1), L(x, BELT_Y + 5 * s, z), c, "Neon")
	end
	Mk.part(m, "BinBack", Vector3.new(0.8, 5 * s, 10 * s), L(x + 4.4 * s, BELT_Y + 2.5 * s, 0), dark(c, 0.55), "Metal", { collide = true })
	local sign = Mk.part(m, "Sign", Vector3.new(7, 1.6, 0.4), L(x, BELT_Y + 7.5 * s, 0), { 24, 18, 48 }, "SmoothPlastic")
	Mk.label(sign, gold and "MEGA COLLECTOR x1.5" or "COLLECTOR", 1.6, c, UDim2.fromOffset(260, 44), 140)
	Mk.cyl(m, "Funnel", 2, 6 * s, L(x - 1, BELT_Y + 6.2 * s, 0), c, "Neon", { tr = 0.35 })
end

builders.decor = function(m, O, it)
	local function L(x, y, z) return O * CFrame.new(x, y, z) end
	if it.id == "decor_lights" then
		for k = 0, 8 do
			local x = -36 + k * 9
			Mk.part(m, "RoofBar", Vector3.new(0.6, 0.6, 18), L(x, 20, 0), k % 2 == 0 and { 255, 90, 200 } or { 70, 240, 255 }, "Neon")
			Mk.ball(m, "Lamp", 2, L(x, 18.4, 8), k % 2 == 0 and { 255, 90, 200 } or { 70, 240, 255 }, "Neon", { bob = 0.25 })
			Mk.ball(m, "Lamp", 2, L(x, 18.4, -8), k % 2 == 0 and { 70, 240, 255 } or { 255, 90, 200 }, "Neon", { bob = 0.25 })
		end
		Mk.part(m, "RoofSpine", Vector3.new(76, 0.6, 0.6), L(0, 20, 0), { 255, 255, 255 }, "Neon")
	else -- turbine fans
		for _, z in { -22, 22 } do
			Mk.cyl(m, "FanPole", 16, 1.4, L(-20, 8, z), { 60, 52, 90 }, "Metal", { collide = true })
			Mk.ball(m, "FanHub", 3, L(-20, 17, z), it.color, "Neon")
			for b = 0, 3 do
				Mk.part(m, "Blade", Vector3.new(0.4, 9, 2.4), L(-20, 17, z) * CFrame.Angles(0, 0, b * math.pi / 2) * CFrame.new(0, 4.5, 0), { 220, 230, 255 }, "SmoothPlastic", { spin = 4 })
			end
		end
	end
end

builders.overdrive = function(m, O, it)
	local function L(x, y, z) return O * CFrame.new(x, y, z) end
	local z = -24
	Mk.cyl(m, "ReactorBase", 3, 18, L(0, 1.5, z), { 40, 30, 60 }, "Metal", { collide = true })
	Mk.cyl(m, "ReactorCore", 16, 6.4, L(0, 11, z), it.color, "Neon", { tr = 0.2 })
	for k, y in { 7, 12, 17 } do
		Mk.cyl(m, "ReactorRing", 0.8, 11 - k, L(0, y, z), { 255, 215, 90 }, "Neon", { spin = k % 2 == 0 and 2.4 or -2.4 })
	end
	Mk.ball(m, "ReactorOrb", 5, L(0, 21.5, z), { 255, 255, 255 }, "Neon", { bob = 0.6 })
	Mk.light(m:FindFirstChild("ReactorOrb") :: Instance, it.color, 40, 2.5)
	local sign = Mk.part(m, "Sign", Vector3.new(9, 2, 0.5), L(0, 26, z), { 24, 18, 48 }, "SmoothPlastic")
	Mk.label(sign, "OVERDRIVE REACTOR", 2, it.color, UDim2.fromOffset(300, 50), 200)
	local pad = Mk.cyl(m, "OverdrivePad", 0.6, 7, L(0, 3.3, z + 11), it.color, "Neon", { collide = true })
	local pp = Instance.new("ProximityPrompt")
	pp.ObjectText = "Overdrive Reactor"
	pp.ActionText = "Hold to trigger OVERDRIVE"
	pp.HoldDuration = 2
	pp.MaxActivationDistance = 12
	pp.RequiresLineOfSight = false
	pp.Parent = pad
	pp:SetAttribute("Action", "overdrive")
end

function Factory.buildItem(folder: Instance, O: CFrame, it): Model
	local old = folder:FindFirstChild(it.id)
	if old then
		old:Destroy()
	end
	local m = Instance.new("Model")
	m.Name = it.id
	local b = builders[it.kind]
	if b then
		b(m, O, it)
	end
	m.Parent = folder
	return m
end

-- the buy pad: a glowing disc showing the next piece and its price
function Factory.buildPad(folder: Instance, O: CFrame): Part
	local pad = Mk.cyl(folder, "BuyPad", 0.8, 11, O * CFrame.new(0, 0.9, Config.Plots.BUTTON_Z), { 70, 240, 255 }, "Neon", { collide = true, touch = true })
	Mk.cyl(folder, "BuyPadRim", 0.6, 12.5, O * CFrame.new(0, 0.8, Config.Plots.BUTTON_Z), { 40, 30, 70 }, "Metal")
	Mk.ball(folder, "BuyPadOrb", 2.4, O * CFrame.new(0, 6, Config.Plots.BUTTON_Z), { 255, 255, 255 }, "Neon", { bob = 0.5 })
	return pad
end

return Factory
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">ProgressService</string>
          <string name="Source"><![CDATA[-- Single choke point for "this player's profile changed": derived unlocks, character stats / cosmetics attributes,
-- leaderstats, notifications and a state push.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Rules)
local Sessions = require(script.Parent.Sessions)
local StateService = require(script.Parent.StateService)

local ProgressService = {}

local function leaderstats(player: Player): Folder
	local f = player:FindFirstChild("leaderstats")
	if not f then
		f = Instance.new("Folder")
		f.Name = "leaderstats"
		f.Parent = player
		for _, n in { "Floor", "Crowns", "Overdrive" } do
			local v = Instance.new("IntValue")
			v.Name = n
			v.Parent = f
		end
	end
	return f :: Folder
end

function ProgressService.applyCharacter(session: Sessions.Session)
	local char = session.player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local mv = Rules.movement(session.profile)
	hum.UseJumpPower = true
	hum.WalkSpeed = mv.walk
	hum.JumpPower = mv.jump
end

function ProgressService.publish(session: Sessions.Session)
	local p, player = session.profile, session.player
	player:SetAttribute("Trail", p.trail)
	player:SetAttribute("Aura", p.aura)
	player:SetAttribute("TitleText", p.title)
	player:SetAttribute("Crowns", p.crowns)
	player:SetAttribute("Overdrive", p.overdrive)
	player:SetAttribute("Floor", p.checkpoint)
	player:SetAttribute("DoubleJump", p.perks.double_jump == true)
	player:SetAttribute("Magnet", Rules.movement(p).magnet)
	local ls = leaderstats(player)
	ls.Floor.Value = p.reached
	ls.Crowns.Value = p.crowns
	ls.Overdrive.Value = p.overdrive
end

-- events: optional notification payloads already produced by the caller's mutation
function ProgressService.commit(session: Sessions.Session, events: { { [string]: any } }?)
	for _, e in Rules.unlocks(session.profile) do
		StateService.notify(session.player, { kind = "unlock", what = e.kind, id = e.id })
	end
	for _, e in (events or {}) :: { { [string]: any } } do
		StateService.notify(session.player, e)
	end
	ProgressService.applyCharacter(session)
	ProgressService.publish(session)
	StateService.markDirty(session)
end

return ProgressService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">RateLimit</string>
          <string name="Source"><![CDATA[-- Token-bucket rate limiter for client-triggered remotes (per player, per key).
local RateLimit = {}

local buckets: { [Player]: { [string]: { tokens: number, t: number } } } = {}

-- allow(player, "buy", 4, 8): up to `burst` calls at once, refilling `perSecond` tokens per second.
function RateLimit.allow(player: Player, key: string, perSecond: number, burst: number?): boolean
	local now = os.clock()
	local pb = buckets[player]
	if not pb then
		pb = {}
		buckets[player] = pb
	end
	local b = pb[key]
	local cap = burst or perSecond
	if not b then
		b = { tokens = cap, t = now }
		pb[key] = b
	end
	b.tokens = math.min(cap, b.tokens + (now - b.t) * perSecond)
	b.t = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

function RateLimit.forget(player: Player)
	buckets[player] = nil
end

return RateLimit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Sessions</string>
          <string name="Source"><![CDATA[-- Per-player runtime state that lives only on this server (the persistent part is session.profile).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Rules)

local Sessions = {}

export type Session = {
	player: Player,
	profile: any,
	ready: boolean, -- client connected its handlers (events sent earlier would be lost)
	lastSent: number,
	plot: number?, -- plot index owned by this player
	inTower: boolean, -- respawn at the tower checkpoint instead of at the plot
	lastCheckpoint: number, -- last checkpoint floor touched in this life of the session (0 = none)
	checkpointAt: number, -- os.clock() when it was touched
	lastGoto: number,
	dropperClock: number, -- last factory tick (server time)
	arrivals: { { t: number, id: string } },
	pendingCash: number,
	pendingOres: number,
	fraction: number,
	lastTick: number,
	busy: boolean,
	boostToken: number,
	coinsTaken: { [Instance]: boolean },
	loadedAt: number,
	lastSave: number,
}

local byPlayer: { [Player]: Session } = {}

function Sessions.create(player: Player, profile: any): Session
	local s: Session = {
		player = player, profile = profile, ready = false, lastSent = 0, plot = nil, inTower = false, lastCheckpoint = 0,
		checkpointAt = 0, lastGoto = 0, dropperClock = 0, arrivals = {}, pendingCash = 0, pendingOres = 0, fraction = 0,
		lastTick = 0, busy = false, boostToken = 0, coinsTaken = {}, loadedAt = os.clock(), lastSave = os.clock(),
	}
	byPlayer[player] = s
	return s
end

function Sessions.get(player: Player): Session?
	return byPlayer[player]
end

function Sessions.remove(player: Player)
	byPlayer[player] = nil
end

function Sessions.all(): { [Player]: Session }
	return byPlayer
end

function Sessions.movement(session: Session)
	return Rules.movement(session.profile)
end

return Sessions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Perks, cosmetics and settings (all whitelisted; every remote validates its input).
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Remotes)
local Sessions = require(script.Parent.Sessions)
local StateService = require(script.Parent.StateService)
local ProgressService = require(script.Parent.ProgressService)
local RateLimit = require(script.Parent.RateLimit)

local ShopService = {}

function ShopService.start()
	Remotes.get("BuyPerk").OnServerInvoke = function(player: Player, id: any)
		if not RateLimit.allow(player, "perk", 3, 5) then
			return { ok = false, reason = "slow_down" }
		end
		local session = Sessions.get(player)
		if not session or type(id) ~= "string" or #id > 40 then
			return { ok = false, reason = "invalid" }
		end
		local ok, reason = Rules.buyPerk(session.profile, id)
		if ok then
			ProgressService.commit(session, { { kind = "perk", id = id } })
		end
		return { ok = ok, reason = reason }
	end

	Remotes.get("Equip").OnServerInvoke = function(player: Player, kind: any, id: any)
		if not RateLimit.allow(player, "equip", 4, 6) then
			return { ok = false }
		end
		local session = Sessions.get(player)
		if not session or type(kind) ~= "string" or type(id) ~= "string" or #id > 40 then
			return { ok = false }
		end
		local ok = false
		if kind == "trail" then
			ok = Rules.equipTrail(session.profile, id)
		elseif kind == "aura" then
			ok = Rules.equipAura(session.profile, id)
		elseif kind == "title" then
			local Profile = require(Shared.Profile)
			if Profile.validTitles[id] and Rules.titleFor(session.profile.crowns) ~= nil then
				-- a title can be worn once the crowns for it were earned
				local cfg = require(Shared.Config)
				for _, t in cfg.Titles do
					if t.id == id and session.profile.crowns >= t.crowns then
						session.profile.title = id
						ok = true
					end
				end
			end
		end
		if ok then
			ProgressService.commit(session)
		end
		return { ok = ok }
	end

	Remotes.get("SetSetting").OnServerInvoke = function(player: Player, key: any, value: any)
		if not RateLimit.allow(player, "settings", 4, 6) then
			return { ok = false }
		end
		local session = Sessions.get(player)
		if not session or type(key) ~= "string" or type(value) ~= "boolean" then
			return { ok = false }
		end
		if session.profile.settings[key] == nil then
			return { ok = false } -- unknown keys are rejected, never created
		end
		session.profile.settings[key] = value
		StateService.markDirty(session)
		return { ok = true }
	end
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">StateService</string>
          <string name="Source"><![CDATA[-- Builds and pushes the profile snapshot the HUD/menus render, and delivers one-off Notify events.
-- The client never computes economy values: everything it shows comes from here.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Remotes)
local Sessions = require(script.Parent.Sessions)

local RunService = game:GetService("RunService")

local StateService = {}

local stateEvent: RemoteEvent, notifyEvent: RemoteEvent
local dirty: { [any]: boolean } = {}

function StateService.snapshot(session: Sessions.Session)
	local p = session.profile
	local nxt = Rules.nextItem(p)
	local nextInfo = nil
	if nxt then
		local ok, reason, cost = Rules.canBuyItem(p, nxt.id)
		nextInfo = { id = nxt.id, name = nxt.name, cost = cost, kind = nxt.kind, affordable = ok, reason = reason }
	end
	local titles = {}
	return {
		cash = p.cash, crowns = p.crowns, overdrive = p.overdrive, reached = p.reached, checkpoint = p.checkpoint,
		floors = table.clone(p.floors), items = table.clone(p.items), perks = table.clone(p.perks), trails = table.clone(p.trails),
		auras = table.clone(p.auras), trail = p.trail, aura = p.aura, title = p.title, titles = titles,
		counters = table.clone(p.stats), settings = table.clone(p.settings),
		income = Rules.income(p), mult = Rules.cashMult(p), movement = Rules.movement(p),
		nextItem = nextInfo, canOverdrive = Rules.canOverdrive(p),
		skipCost = if p.checkpoint < Config.Tower.FLOORS then Rules.skipCost(p.checkpoint) else nil,
		objective = Rules.nextObjective(p), plot = session.plot, inTower = session.inTower,
	}
end

function StateService.markDirty(session: Sessions.Session)
	dirty[session] = true
end

function StateService.pushNow(session: Sessions.Session)
	if not session.player.Parent or not session.ready then
		return
	end
	dirty[session] = nil
	session.lastSent = os.clock()
	stateEvent:FireClient(session.player, StateService.snapshot(session))
end

function StateService.notify(player: Player, payload: { [string]: any })
	if player.Parent then
		notifyEvent:FireClient(player, payload)
	end
end

function StateService.forget(session: Sessions.Session)
	dirty[session] = nil
end

function StateService.start()
	stateEvent = Remotes.get("State")
	notifyEvent = Remotes.get("Notify")
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for session in dirty do
			if now - session.lastSent >= 0.15 then
				StateService.pushNow(session)
			end
		end
	end)
end

return StateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">TycoonService</string>
          <string name="Source"><![CDATA[-- Factory economy. Ores are a deterministic schedule: every dropper emits an ore each `interval` seconds on the shared
-- server clock, the ore reaches the collector after a fixed transit time, and cash is credited then using the
-- player's CURRENT multipliers. The client draws the same schedule (see client/PlotVisuals) - no ore parts, no physics.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Remotes)
local Sessions = require(script.Parent.Sessions)
local StateService = require(script.Parent.StateService)
local ProgressService = require(script.Parent.ProgressService)
local PlotService = require(script.Parent.PlotService)
local RateLimit = require(script.Parent.RateLimit)

local TycoonService = {}

local COLLECTOR_X = 35
local FALL_TIME = 0.45

local function clock(): number
	return Workspace:GetServerTimeNow()
end

-- stable per-item phase so droppers do not all fire on the same beat
local function phaseOf(id: string, interval: number): number
	local h = 0
	for i = 1, #id do
		h = (h * 31 + string.byte(id, i)) % 9973
	end
	return (h / 9973) * interval
end
TycoonService.phaseOf = phaseOf

function TycoonService.transit(item): number
	return FALL_TIME + (COLLECTOR_X - item.x) / Config.Tycoon.BELT_SPEED
end

-- number of ores `item` emitted in (t0, t1]
function TycoonService.emissions(item, t0: number, t1: number): { number }
	local ph = phaseOf(item.id, item.interval)
	local a = math.floor((t0 - ph) / item.interval)
	local b = math.floor((t1 - ph) / item.interval)
	local out = {}
	for n = a + 1, b do
		table.insert(out, n * item.interval + ph)
	end
	return out
end

local function step(session: Sessions.Session, now: number)
	if not session.plot then
		return
	end
	local p = session.profile
	local last = session.lastTick
	session.lastTick = now
	if last == 0 or now - last > 5 then
		return -- first tick (or a long stall): no catch-up so nothing is credited twice
	end
	-- emit
	for _, it in Config.Items do
		if it.kind == "dropper" and p.items[it.id] then
			for _, t in TycoonService.emissions(it, last, now) do
				if #session.arrivals < Config.Tycoon.MAX_ORE_PER_PLOT * 4 then
					table.insert(session.arrivals, { t = t + TycoonService.transit(it), id = it.id })
				end
			end
		end
	end
	-- arrive
	local credited, ores = 0, 0
	local keep = {}
	for _, a in session.arrivals do
		if a.t <= now then
			if p.items[a.id] then
				credited += Rules.oreValue(p, a.id)
				ores += 1
			end
		else
			table.insert(keep, a)
		end
	end
	session.arrivals = keep
	-- generators: continuous
	local dt = now - last
	local genMult = Rules.cashMult(p) * Rules.collectorBonus(p)
	for _, it in Config.Items do
		if it.kind == "generator" and p.items[it.id] then
			credited += it.rate * genMult * dt
		end
	end
	if credited > 0 then
		credited += session.fraction
		local whole = math.floor(credited)
		session.fraction = credited - whole
		if whole > 0 then
			Rules.addCash(p, whole)
			session.pendingCash += whole
			session.pendingOres += ores
			StateService.markDirty(session)
		end
	end
end

local accum = 0
function TycoonService.start()
	RunService.Heartbeat:Connect(function(dt)
		local now = clock()
		for _, session in Sessions.all() do
			if session.player.Parent then
				step(session, now)
			end
		end
		accum += dt
		if accum >= 0.4 then
			accum = 0
			for _, session in Sessions.all() do
				if session.pendingCash > 0 and session.ready then
					Remotes.get("CashTick"):FireClient(session.player, session.pendingCash, session.pendingOres)
					session.pendingCash, session.pendingOres = 0, 0
				end
			end
		end
	end)

	local lastPad: { [Player]: number } = {}
	PlotService.onPad = function(index: number, hit: BasePart)
		local plot = PlotService.get(index)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not plot or not player or plot.owner ~= player then
			return
		end
		local now = os.clock()
		if now - (lastPad[player] or 0) < 0.7 then
			return
		end
		lastPad[player] = now
		local session = Sessions.get(player)
		local nxt = session and Rules.nextItem(session.profile)
		if session and nxt then
			local res = TycoonService.buy(player, nxt.id)
			if not res.ok and res.reason == "funds" then
				StateService.notify(player, { kind = "msg", text = ("You need $%s for %s."):format(tostring(Rules.itemCost(nxt, session.profile)), nxt.name), tone = "warn" })
			end
		end
	end
	PlotService.onOverdrive = function(player: Player)
		TycoonService.overdrive(player)
	end

	Remotes.get("Buy").OnServerInvoke = function(player: Player, itemId: any)
		return TycoonService.buy(player, itemId)
	end
	Remotes.get("Overdrive").OnServerInvoke = function(player: Player)
		return TycoonService.overdrive(player)
	end
end

local function nearPad(session: Sessions.Session): boolean
	local plot = session.plot and PlotService.get(session.plot)
	local char = session.player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not plot or not hrp then
		return false
	end
	return (hrp.Position - plot.origin.Position).Magnitude <= 90
end

function TycoonService.buy(player: Player, itemId: any)
	if not RateLimit.allow(player, "buy", 5, 8) then
		return { ok = false, reason = "slow_down" }
	end
	local session = Sessions.get(player)
	if not session then
		return { ok = false, reason = "no_session" }
	end
	if type(itemId) ~= "string" or #itemId > 40 then
		return { ok = false, reason = "invalid" }
	end
	if not session.plot then
		return { ok = false, reason = "no_plot" }
	end
	if not nearPad(session) then
		return { ok = false, reason = "far" }
	end
	if session.busy then
		return { ok = false, reason = "busy" }
	end
	session.busy = true
	local ok, reason = Rules.buyItem(session.profile, itemId) -- validates order, funds and ownership; charges atomically
	session.busy = false
	if not ok then
		return { ok = false, reason = reason }
	end
	local plot = PlotService.get(session.plot)
	local item = Rules.itemById[itemId]
	if plot then
		PlotService.addItem(plot, item)
		PlotService.updatePad(plot, session.profile)
	end
	ProgressService.commit(session, { { kind = "bought", id = itemId, name = item.name, itemKind = item.kind } })
	return { ok = true }
end

function TycoonService.overdrive(player: Player)
	if not RateLimit.allow(player, "overdrive", 0.5, 2) then
		return { ok = false, reason = "slow_down" }
	end
	local session = Sessions.get(player)
	if not session or not session.plot then
		return { ok = false, reason = "no_session" }
	end
	if session.busy then
		return { ok = false, reason = "busy" }
	end
	session.busy = true
	local ok = Rules.overdrive(session.profile)
	session.busy = false
	if not ok then
		return { ok = false, reason = "locked" }
	end
	session.arrivals = {}
	session.fraction = 0
	local plot = PlotService.get(session.plot)
	if plot then
		PlotService.build(plot, session.profile)
		PlotService.updatePad(plot, session.profile)
	end
	ProgressService.commit(session, { { kind = "overdrive", count = session.profile.overdrive } })
	return { ok = true, count = session.profile.overdrive }
end

return TycoonService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">WorldSetup</string>
          <string name="Source"><![CDATA[-- One-time world dressing at server start: lighting, sky, hub spawn, title sign, floor banners and per-floor effects.
-- The baked map only contains invisible Marker parts for these; everything dynamic is created here.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Mk = require(script.Parent.Mk)

local WorldSetup = {}

local function setupLighting()
	Lighting.ClockTime = 20.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(90, 70, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(110, 90, 170)
	Lighting.ColorShift_Top = Color3.fromRGB(170, 110, 255)
	Lighting.EnvironmentDiffuseScale = 0.7
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	for _, name in { "NfAtmosphere", "NfColor", "NfBloom", "NfSky", "NfSunRays", "NfDepth" } do
		local old = Lighting:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local sky = Instance.new("Sky")
	sky.Name = "NfSky"
	sky.StarCount = 4000
	sky.Parent = Lighting
	local atm = Instance.new("Atmosphere")
	atm.Name = "NfAtmosphere"
	atm.Density = 0.3
	atm.Offset = 0.25
	atm.Color = Color3.fromRGB(190, 140, 255)
	atm.Decay = Color3.fromRGB(110, 70, 190)
	atm.Glare = 0.3
	atm.Haze = 1.2
	atm.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "NfColor"
	cc.Saturation = 0.25
	cc.Contrast = 0.12
	cc.TintColor = Color3.fromRGB(245, 235, 255)
	cc.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "NfBloom"
	bloom.Intensity = 0.9
	bloom.Size = 36
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "NfSunRays"
	rays.Intensity = 0.12
	rays.Spread = 0.8
	rays.Parent = Lighting
end

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- particle recipes per floor family (matches Config.Floors[n].sky.particles)
local function emitter(kind: string, glow: { number }, accent: { number }): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.LightEmission = 0.8
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(4, 8)
	pe.Speed = NumberRange.new(0.5, 2)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(rgb(glow), rgb(accent))
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.7), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Shape = Enum.ParticleEmitterShape.Box
	if kind == "ember" then
		pe.Acceleration = Vector3.new(0, 4, 0)
		pe.Speed = NumberRange.new(2, 5)
	elseif kind == "snow" or kind == "petal" or kind == "leaf" then
		pe.Acceleration = Vector3.new(0, -2.5, 0)
		pe.Rate = 24
		pe.Size = NumberSequence.new(0.5)
	elseif kind == "rain" then
		pe.Acceleration = Vector3.new(0, -60, 0)
		pe.Rate = 80
		pe.Lifetime = NumberRange.new(0.6, 1)
		pe.Size = NumberSequence.new(0.2)
		pe.Speed = NumberRange.new(0, 0)
	elseif kind == "bubble" then
		pe.Acceleration = Vector3.new(0, 3, 0)
	elseif kind == "void" then
		pe.Acceleration = Vector3.new(0, 0.5, 0)
		pe.Speed = NumberRange.new(4, 8)
		pe.LightEmission = 1
	elseif kind == "star" then
		pe.Rate = 30
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 1.2), NumberSequenceKeypoint.new(1, 0) })
	end
	return pe
end

function WorldSetup.run(world: Instance)
	setupLighting()
	local hubSpawn = world:FindFirstChild("Marker:HubSpawn", true) :: BasePart?
	if hubSpawn then
		local sp = Instance.new("SpawnLocation")
		sp.Name = "HubSpawn"
		sp.Anchored = true
		sp.CanCollide = false
		sp.Transparency = 1
		sp.Neutral = true
		sp.Duration = 0
		sp.Size = Vector3.new(20, 1, 20)
		sp.CFrame = hubSpawn.CFrame
		sp.Parent = Workspace
	end
	local title = world:FindFirstChild("Marker:Title", true) :: BasePart?
	if title then
		Mk.label(title, "NEONFORGE", 0, Config.Colors.cyan, UDim2.fromOffset(900, 200), 1500)
		Mk.label(title, "TOWER TYCOON", -7, Config.Colors.magenta, UDim2.fromOffset(500, 90), 1200)
	end
	for floor = 1, Config.Tower.FLOORS + 1 do
		local theme = Config.Floors[math.min(floor, Config.Tower.FLOORS)]
		local banner = world:FindFirstChild("Marker:Banner:" .. floor, true) :: BasePart?
		if banner then
			local text = if floor <= Config.Tower.FLOORS then ("FLOOR %d  -  %s"):format(floor, theme.name) else "THE SUMMIT"
			Mk.label(banner, text, 0, theme.glow, UDim2.fromOffset(620, 100), 400)
		end
		local fx = world:FindFirstChild("Marker:FX:" .. floor, true) :: BasePart?
		if fx then
			fx.Size = Vector3.new(44, 26, 60)
			local e = emitter(theme.sky.particles, theme.glow, theme.accent)
			e.Parent = fx
			Mk.light(fx, theme.glow, 55, 2.2)
		end
	end
end

return WorldSetup
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="26">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="27">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Animator</string>
            <string name="Source"><![CDATA[-- Animates decorative parts near the camera: runtime machines tagged with Bob/Spin attributes and the baked coins.
-- Purely local (the server never sees these CFrame changes).
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Animator = {}

type Item = { part: BasePart, base: CFrame, bob: number, spin: number, phase: number, cyl: boolean }
local items: { [BasePart]: Item } = {}

local function consider(d: Instance)
	if not d:IsA("BasePart") then
		return
	end
	local bob, spin = d:GetAttribute("Bob"), d:GetAttribute("Spin")
	if d.Name == "Coin" then
		spin, bob = 2.4, 0.5
	end
	if (bob or spin) and not items[d] then
		items[d] = { part = d, base = d.CFrame, bob = (bob or 0) :: number, spin = (spin or 0) :: number, phase = math.random() * 6.28, cyl = d:IsA("Part") and (d :: Part).Shape == Enum.PartType.Cylinder }
		d.AncestryChanged:Connect(function()
			if not d.Parent then
				items[d] = nil
			end
		end)
	end
end

function Animator.init()
	for _, root in { Workspace:WaitForChild("Factories"), Workspace:WaitForChild("World") } do
		for _, d in root:GetDescendants() do
			consider(d)
		end
		root.DescendantAdded:Connect(consider) -- streaming: parts arrive and leave while you move
	end
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		if acc < 1 / 40 then
			return
		end
		acc = 0
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		local camPos = cam.CFrame.Position
		local now = os.clock()
		for _, it in items do
			local p = it.part
			if (p.Position - camPos).Magnitude < 140 then
				local off = if it.bob > 0 then math.sin(now * 2 + it.phase) * it.bob else 0
				p.CFrame = CFrame.new(0, off, 0) * it.base * (if it.cyl then CFrame.Angles(it.spin * now, 0, 0) else CFrame.Angles(0, it.spin * now, 0))
			end
		end
	end)
end

return Animator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Feedback</string>
            <string name="Source"><![CDATA[-- Reaction to server Notify events: toasts, banners, floating numbers, screen flashes, confetti and sounds.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.State)

local Feedback = {}
local T = UIKit.theme

local toastHolder: Frame, bannerHolder: Frame, flash: Frame
local bannerQueue: { { title: string, sub: string, color: Color3 } } = {}
local bannerBusy = false
local toasts: { Frame } = {}
local shakeFn: ((number, number) -> ())? = nil
local confettiFn: (() -> ())? = nil
local lastCoin, coinCombo = 0, 0

-- other modules plug their effects in here (avoids circular requires)
function Feedback.setEffects(shake: (number, number) -> (), confetti: () -> ())
	shakeFn, confettiFn = shake, confetti
end

local function localRoot(): BasePart?
	local c = Players.LocalPlayer.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Feedback.toast(text: string, tone: string?)
	local color = if tone == "good" then T.good elseif tone == "warn" then T.warn elseif tone == "bad" then T.bad else T.cyan
	local f = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, UIKit.px(34)), BackgroundColor3 = T.bg, BackgroundTransparency = 0.1, BorderSizePixel = 0, LayoutOrder = math.floor(os.clock() * 100), Parent = toastHolder,
	}, { UIKit.corner(10), UIKit.stroke(color, 1.5, 0.1) })
	UIKit.label({ Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Text = text, TextSize = UIKit.px(13), Font = T.fontBold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, Parent = f })
	table.insert(toasts, f)
	while #toasts > 3 do
		local old = table.remove(toasts, 1)
		if old then
			old:Destroy()
		end
	end
	task.delay(3.4, function()
		if f.Parent then
			TweenService:Create(f, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
			for _, d in f:GetDescendants() do
				if d:IsA("TextLabel") then
					TweenService:Create(d, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
				elseif d:IsA("UIStroke") then
					TweenService:Create(d, TweenInfo.new(0.35), { Transparency = 1 }):Play()
				end
			end
			task.delay(0.4, function()
				local i = table.find(toasts, f)
				if i then
					table.remove(toasts, i)
				end
				f:Destroy()
			end)
		end
	end)
end

local function runBanner()
	if bannerBusy then
		return
	end
	bannerBusy = true
	task.spawn(function()
		while #bannerQueue > 0 do
			local b = table.remove(bannerQueue, 1) :: any
			local f = UIKit.new("Frame", {
				Size = UDim2.fromOffset(math.floor(400 * UIKit.factor()), UIKit.px(96)), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -140),
				BackgroundColor3 = T.bg, BackgroundTransparency = 0.04, BorderSizePixel = 0, Parent = bannerHolder,
			}, { UIKit.corner(14), UIKit.stroke(b.color, 3, 0) })
			UIKit.title({ Size = UDim2.new(1, -16, 0, UIKit.px(38)), Position = UDim2.fromOffset(8, 6), Text = b.title, TextSize = UIKit.px(26), TextColor3 = b.color, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Parent = f })
			UIKit.label({ Size = UDim2.new(1, -16, 0, UIKit.px(44)), Position = UDim2.fromOffset(8, UIKit.px(44)), Text = b.sub, TextSize = UIKit.px(13), TextXAlignment = Enum.TextXAlignment.Center, Parent = f })
			TweenService:Create(f, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0.2, 0) }):Play()
			task.wait(if #bannerQueue > 0 then 1.9 else 3.2)
			TweenService:Create(f, TweenInfo.new(0.3), { Position = UDim2.new(0.5, 0, 0, -140) }):Play()
			task.wait(0.35)
			f:Destroy()
		end
		bannerBusy = false
	end)
end

function Feedback.banner(title: string, sub: string, color: Color3?)
	if #bannerQueue >= 3 then
		table.remove(bannerQueue, 1)
	end
	table.insert(bannerQueue, { title = title, sub = sub, color = color or T.cyan })
	runBanner()
end

function Feedback.flash(color: Color3, strength: number)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 1 - strength
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
end

-- rising number above a world position
function Feedback.floatAt(position: Vector3, text: string, color: Color3, size: number?)
	local anchor = Instance.new("Part")
	anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = true, false, false, false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.Position = position
	anchor.Parent = Workspace
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(240, 50)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local l = UIKit.title({ Size = UDim2.fromScale(1, 1), Text = text, TextSize = size or UIKit.px(24), TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Parent = gui })
	l.TextStrokeTransparency = 0.3
	TweenService:Create(anchor, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = position + Vector3.new(0, 6, 0) }):Play()
	TweenService:Create(l, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1.2)
end

local function rewardLine(n: any): string
	local parts = {}
	if n.crowns and n.crowns > 0 then
		table.insert(parts, ("+%d Crowns"):format(n.crowns))
	end
	if n.cash and n.cash > 0 then
		table.insert(parts, ("+$%s"):format(UIKit.fmt(n.cash)))
	end
	return table.concat(parts, "   ")
end

local handlers: { [string]: (any) -> () } = {}

handlers.bought = function(n)
	Sfx.play("buy")
	Feedback.toast("Machine online: " .. n.name, "good")
	local hrp = localRoot()
	if hrp then
		Feedback.floatAt(hrp.Position + Vector3.new(0, 5, 0), n.name, T.cyan, UIKit.px(20))
	end
end

handlers.perk = function(n)
	Sfx.play("unlock")
	for _, p in Config.Perks do
		if p.id == n.id then
			Feedback.banner("Perk unlocked", p.name .. ": " .. p.desc, T.cyan)
		end
	end
end

handlers.overdrive = function(n)
	Sfx.play("overdrive")
	Feedback.flash(Color3.new(1, 1, 1), 0.85)
	Feedback.banner("OVERDRIVE x" .. n.count, ("Your factory restarts with +%d%% cash forever."):format(Config.Tycoon.OVERDRIVE_BONUS * 100 * n.count), T.magenta)
	if shakeFn then
		shakeFn(0.8, 0.8)
	end
	if confettiFn then
		confettiFn()
	end
end

handlers.floorClear = function(n)
	Sfx.play("floor_clear")
	Feedback.flash(T.gold, 0.35)
	local title = if n.summit then "TOWER CONQUERED!" elseif n.first then ("FLOOR %d CLEARED!"):format(n.floor) else ("Floor %d again"):format(n.floor)
	Feedback.banner(title, n.name .. (if rewardLine(n) ~= "" then "\n" .. rewardLine(n) else ""), T.gold)
	if confettiFn and n.first then
		confettiFn()
	end
end

handlers.checkpoint = function(n)
	Sfx.play("checkpoint")
	Feedback.toast(("Checkpoint saved: floor %d, %s"):format(n.floor, n.name), "good")
end

handlers.coin = function(n)
	local now = os.clock()
	coinCombo = if now - lastCoin < 1.4 then math.min(coinCombo + 1, 10) else 0
	lastCoin = now
	Sfx.play("coin", 1 + coinCombo * 0.06)
	local hrp = localRoot()
	if hrp then
		Feedback.floatAt(hrp.Position + Vector3.new(0, 4, 0), "+$" .. UIKit.fmt(n.cash), T.gold, UIKit.px(18))
	end
end

handlers.death = function()
	Sfx.play("death")
	Feedback.flash(T.bad, 0.4)
	if shakeFn then
		shakeFn(0.5, 0.35)
	end
end

handlers.unlock = function(n)
	Sfx.play("unlock")
	local label = if n.what == "trail" then "New trail unlocked" elseif n.what == "aura" then "New aura unlocked" else "New title earned"
	local name = n.id
	for _, list in { Config.Trails, Config.Auras } do
		for _, e in list do
			if e.id == n.id then
				name = e.name
			end
		end
	end
	Feedback.banner(label, name .. (if n.what ~= "title" then "\nOpen the Style menu to wear it." else ""), T.magenta)
end

handlers.fx = function(n)
	if n.what == "bounce" then
		Sfx.play("bounce")
	elseif n.what == "speed" then
		Sfx.play("speed")
	end
end

handlers.msg = function(n)
	if n.tone == "warn" then
		Sfx.play("deny")
	end
	Feedback.toast(n.text, n.tone)
end

function Feedback.init(gui: ScreenGui)
	local f = UIKit.factor()
	toastHolder = UIKit.new("Frame", {
		Name = "Toasts", Size = UDim2.fromOffset(math.floor((if UIKit.isTouch() then 280 else 380) * f), 0), AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0.5, 0, 1, -math.floor(64 * f)), AnchorPoint = Vector2.new(0.5, 1), BackgroundTransparency = 1, Parent = gui,
	})
	UIKit.list(toastHolder, 4).VerticalAlignment = Enum.VerticalAlignment.Bottom
	bannerHolder = UIKit.new("Frame", { Name = "Banners", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })
	flash = UIKit.new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50, Active = false, Parent = gui })
	Remotes.get("Notify").OnClientEvent:Connect(function(n)
		local h = type(n) == "table" and handlers[n.kind]
		if h then
			h(n)
		end
	end)
	local lastCashSound = 0
	Remotes.get("CashTick").OnClientEvent:Connect(function(amount: number)
		local now = os.clock()
		if State.data and amount > 0 and now - lastCashSound > 1.1 then
			lastCashSound = now
			Sfx.play("cash", 1 + math.min(amount / 5e6, 0.5))
		end
	end)
end

return Feedback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Compact HUD: cash / income / crowns (top-left), floor + objective (top-centre), title / overdrive (top-right),
-- menu buttons (right column on desktop, bar under the title card on touch), travel button (bottom-centre).
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Menus = require(script.Parent.Menus)

local Hud = {}
local T = UIKit.theme

local refs: { [string]: any } = {}
local dots: { [string]: Frame } = {}
local shownCash = 0

local function card(parent: Instance, name: string, size: UDim2, pos: UDim2, anchor: Vector2?): Frame
	return UIKit.new("Frame", {
		Name = name, Size = size, Position = pos, AnchorPoint = anchor or Vector2.new(0, 0), BackgroundColor3 = T.bg, BackgroundTransparency = 0.15,
		BorderSizePixel = 0, Active = true, Parent = parent,
	}, { UIKit.corner(12), UIKit.stroke(T.panel2, 1.5, 0.1) })
end

function Hud.build(gui: ScreenGui)
	local touch = UIKit.isTouch()
	local f = UIKit.factor()

	-- ===== top-left: cash =====
	local tl = card(gui, "StatsCard", UDim2.fromOffset(math.floor(215 * f), math.floor(92 * f)), UDim2.fromOffset(10, 10))
	UIKit.pad(8).Parent = tl
	refs.cash = UIKit.title({ Size = UDim2.new(1, 0, 0, math.floor(36 * f)), Text = "$0", TextSize = UIKit.px(32), TextColor3 = T.gold, TextWrapped = false, Parent = tl })
	refs.income = UIKit.label({
		Size = UDim2.new(1, 0, 0, UIKit.px(16)), Position = UDim2.fromOffset(0, math.floor(38 * f)), Text = "", TextSize = UIKit.px(13), TextColor3 = T.cyan,
		Font = T.fontBold, TextWrapped = false, Parent = tl,
	})
	refs.crowns = UIKit.label({
		Size = UDim2.new(1, 0, 0, UIKit.px(16)), Position = UDim2.fromOffset(0, math.floor(58 * f)), Text = "", TextSize = UIKit.px(13), TextColor3 = T.magenta,
		Font = T.fontBold, TextWrapped = false, Parent = tl,
	})

	-- ===== top-centre: floor + objective =====
	local fc = card(gui, "FloorCard", UDim2.fromOffset(math.floor(300 * f), math.floor(76 * f)), UDim2.new(0.5, 0, 0, 10), Vector2.new(0.5, 0))
	UIKit.pad(8).Parent = fc
	refs.floorCard = fc
	refs.floorTitle = UIKit.title({ Size = UDim2.new(1, 0, 0, UIKit.px(22)), Text = "", TextSize = UIKit.px(18), TextWrapped = false, Parent = fc })
	refs.objective = UIKit.label({
		Size = UDim2.new(1, 0, 0, UIKit.px(30)), Position = UDim2.fromOffset(0, UIKit.px(22)), Text = "", TextSize = UIKit.px(12), TextColor3 = T.dim,
		TextYAlignment = Enum.TextYAlignment.Top, Parent = fc,
	})
	local _, floorSet = UIKit.bar({ Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 1, -6), Parent = fc }, T.magenta)
	refs.floorBar = floorSet

	-- ===== top-right: title card =====
	local tr = card(gui, "TitleCard", UDim2.fromOffset(math.floor(190 * f), math.floor(66 * f)), UDim2.new(1, -10, 0, 10), Vector2.new(1, 0))
	UIKit.pad(8).Parent = tr
	refs.titleText = UIKit.label({ Size = UDim2.new(1, 0, 0, UIKit.px(18)), Text = "", TextSize = UIKit.px(14), Font = T.fontBold, TextColor3 = T.gold, TextWrapped = false, Parent = tr })
	refs.odText = UIKit.label({ Size = UDim2.new(1, 0, 0, UIKit.px(16)), Position = UDim2.fromOffset(0, UIKit.px(22)), Text = "", TextSize = UIKit.px(12), TextColor3 = T.dim, TextWrapped = false, Parent = tr })

	-- ===== menu buttons =====
	local defs = { { "shop", "Shop" }, { "tower", "Tower" }, { "style", "Style" }, { "settings", "Settings" } }
	local col
	if touch then
		col = UIKit.new("Frame", {
			Name = "MenuBar", Size = UDim2.fromOffset(4 * math.floor(64 * f) + 3 * 4, math.floor(30 * f)), Position = UDim2.new(1, -10, 0, 10 + math.floor(78 * f) + 4),
			AnchorPoint = Vector2.new(1, 0), BackgroundTransparency = 1, Parent = gui,
		})
		UIKit.list(col, 4, true)
	else
		col = UIKit.new("Frame", {
			Name = "MenuColumn", Size = UDim2.fromOffset(math.floor(120 * f), 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = gui,
		})
		UIKit.list(col, 6)
	end
	for i, d in defs do
		local b = UIKit.button({
			Size = if touch then UDim2.fromOffset(math.floor(64 * f), math.floor(30 * f)) else UDim2.new(1, 0, 0, math.floor(36 * f)), Text = d[2], LayoutOrder = i,
			style = "ghost", BackgroundTransparency = 0.1, TextSize = if touch then 11 else UIKit.px(14), Parent = col,
		}, function()
			Menus.toggle(d[1])
		end)
		UIKit.stroke(T.panel2, 1.2, 0.1).Parent = b
		dots[d[1]] = UIKit.new("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.new(1, -2, 0, 2), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = T.warn, Visible = false, ZIndex = 5, Parent = b }, { UIKit.corner(6) })
	end

	-- ===== travel button (bottom-centre) =====
	refs.travel = UIKit.button({
		Name = "TravelButton", Size = UDim2.fromOffset(math.floor(150 * f), math.floor(40 * f)), Position = UDim2.new(0.5, 0, 1, -math.floor(14 * f)), AnchorPoint = Vector2.new(0.5, 1),
		Text = "TO TOWER", style = "primary", TextSize = UIKit.px(15), Parent = gui,
	}, function()
		local d = State.data
		if d then
			pcall(function()
				Remotes.get("Teleport"):InvokeServer(if d.inTower then "home" else "tower")
			end)
		end
	end)

	-- cash counts up smoothly instead of jumping
	RunService.Heartbeat:Connect(function(dt)
		local d = State.data
		if not d or not refs.cash then
			return
		end
		local target = d.cash
		if shownCash ~= target then
			shownCash += (target - shownCash) * (1 - math.exp(-dt * 9))
			if math.abs(target - shownCash) < 1 then
				shownCash = target
			end
			refs.cash.Text = "$" .. UIKit.fmt(shownCash)
		end
	end)

	Hud.refresh()
	State.changed:Connect(Hud.refresh)
end

local lastCash = 0
function Hud.refresh()
	local d = State.data
	if not d or not refs.cash then
		return
	end
	if d.cash > lastCash and refs.cash then
		-- a small pulse whenever money comes in
		TweenService:Create(refs.cash, TweenInfo.new(0.12), { TextSize = UIKit.px(35) }):Play()
		task.delay(0.12, function()
			TweenService:Create(refs.cash, TweenInfo.new(0.2), { TextSize = UIKit.px(32) }):Play()
		end)
	end
	lastCash = d.cash
	refs.income.Text = ("+$%s/s    x%.2f"):format(UIKit.fmt(d.income), d.mult)
	refs.crowns.Text = ("CROWNS %d"):format(d.crowns)
	local floor = d.checkpoint
	local theme = Config.Floors[floor]
	refs.floorTitle.Text = ("FLOOR %d/%d  %s"):format(floor, Config.Tower.FLOORS, theme.name)
	refs.floorTitle.TextColor3 = UIKit.rgb(theme.glow)
	local cleared = 0
	for _ in d.floors do
		cleared += 1
	end
	refs.floorBar(cleared / Config.Tower.FLOORS, nil, UIKit.rgb(theme.glow))
	refs.objective.Text = d.objective.text
	refs.titleText.Text = d.title
	refs.odText.Text = if d.overdrive > 0 then ("Overdrive x%d"):format(d.overdrive) else ("Floors cleared %d/%d"):format(cleared, Config.Tower.FLOORS)
	refs.travel.Text = if d.inTower then "TO PLOT" else "TO TOWER"

	local perkAffordable = false
	for _, p in Config.Perks do
		if not d.perks[p.id] and d.cash >= p.cost then
			perkAffordable = true
		end
	end
	dots.shop.Visible = perkAffordable or d.canOverdrive
	dots.tower.Visible = false
	dots.style.Visible = false
	dots.settings.Visible = false
end

function Hud.isTouchDevice(): boolean
	return UserInputService.TouchEnabled
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="32">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- NEONFORGE client entry point. Every system starts in its own pcall so one failure cannot take the interface down.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Client = script.Parent
local State = require(Client.State)
local UIKit = require(Client.UIKit)
local Sfx = require(Client.Sfx)

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "NeonforgeUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")

UIKit.onClickSound = function()
	Sfx.play("click")
end

local function safe(name: string, fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		warn(("[Neonforge] %s failed to start: %s"):format(name, tostring(err)))
	end
end

task.spawn(function()
	for _ = 1, 10 do -- the default hotbar / health bar are not used by this game
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end)

Remotes.get("State").OnClientEvent:Connect(function(snapshot)
	State.set(snapshot)
end)

safe("HUD", function()
	require(Client.Hud).build(gui)
end)
local Feedback
safe("Feedback", function()
	Feedback = require(Client.Feedback)
	Feedback.init(gui)
end)
local toast = function(text: string, tone: string?)
	if Feedback then
		Feedback.toast(text, tone)
	end
end
safe("Panels", function()
	require(Client.ShopPanel).create(gui, toast)
	require(Client.TowerPanel).create(gui, toast)
	require(Client.StylePanel).create(gui)
	require(Client.SettingsPanel).create(gui)
end)
safe("PlayerFx", function()
	require(Client.PlayerFx).init()
end)
safe("Movement", function()
	require(Client.Movement).init()
end)
safe("PlotVisuals", function()
	require(Client.PlotVisuals).init()
end)
safe("Animator", function()
	require(Client.Animator).init()
end)
safe("ZoneFx", function()
	require(Client.ZoneFx).init()
end)

-- tell the server every handler is connected: only now does it send the initial state
Remotes.get("ClientReady"):FireServer()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Menus</string>
            <string name="Source"><![CDATA[-- Menu manager: exactly one full panel is open at a time.
local Menus = {}

local panels: { [string]: { frame: Frame, onOpen: (() -> ())? } } = {}
local current: string? = nil

function Menus.register(name: string, frame: Frame, onOpen: (() -> ())?)
	panels[name] = { frame = frame, onOpen = onOpen }
end

function Menus.close()
	if current then
		panels[current].frame.Visible = false
		current = nil
	end
end

function Menus.open(name: string)
	local p = panels[name]
	if not p then
		return
	end
	Menus.close()
	current = name
	if p.onOpen then
		p.onOpen()
	end
	p.frame.Visible = true
end

function Menus.toggle(name: string)
	if current == name then
		Menus.close()
	else
		Menus.open(name)
	end
end

function Menus.current(): string?
	return current
end

return Menus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[-- Client-side movement perks: bounce-pad launches and the Double Jump perk (movement is client-authoritative in
-- Roblox; the server only decides WHICH perks you own via the DoubleJump attribute and walk/jump stats).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Sfx = require(script.Parent.Sfx)

local Movement = {}

local player = Players.LocalPlayer
local canDouble = false

local function ring(hrp: BasePart)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = Color3.fromRGB(70, 240, 255)
	p.Transparency = 0.2
	p.Size = Vector3.new(0.3, 3, 3)
	p.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	p.Parent = Workspace
	local tw = game:GetService("TweenService"):Create(p, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, 12, 12), Transparency = 1 })
	tw:Play()
	game:GetService("Debris"):AddItem(p, 0.6)
end

local function bindCharacter(char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then
		return
	end
	canDouble = false
	hum.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			canDouble = true
		elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running or new == Enum.HumanoidStateType.Seated then
			canDouble = false
		end
	end)
end

function Movement.init()
	Remotes.get("Launch").OnClientEvent:Connect(function(power: number)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp and type(power) == "number" and power > 0 and power < 250 then
			local v = hrp.AssemblyLinearVelocity
			hrp.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
		end
	end)

	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end
	player.CharacterAdded:Connect(bindCharacter)

	UserInputService.JumpRequest:Connect(function()
		if not player:GetAttribute("DoubleJump") or not canDouble then
			return
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hum or not hrp then
			return
		end
		local st = hum:GetState()
		if st ~= Enum.HumanoidStateType.Freefall and st ~= Enum.HumanoidStateType.Jumping then
			return
		end
		canDouble = false
		local v = hrp.AssemblyLinearVelocity
		hrp.AssemblyLinearVelocity = Vector3.new(v.X, hum.JumpPower, v.Z)
		Sfx.play("jump2")
		ring(hrp)
		Remotes.get("Jumped2"):FireServer()
	end)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">PlayerFx</string>
            <string name="Source"><![CDATA[-- Player-facing effects for EVERYONE in the server (driven by replicated attributes): trails, auras, overhead
-- name plates; plus local-only camera effects (shake, speed FOV, confetti) used by Feedback.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Feedback = require(script.Parent.Feedback)

local PlayerFx = {}
local T = UIKit.theme

local trailById, auraById = {}, {}
for _, t in Config.Trails do
	trailById[t.id] = t
end
for _, a in Config.Auras do
	auraById[a.id] = a
end

local function shakeEnabled(): boolean
	local d = State.data
	return not d or d.settings.shake ~= false
end

-- ===== camera shake via Humanoid.CameraOffset =====
local shakeUntil, shakePower = 0, 0
function PlayerFx.shake(power: number, seconds: number)
	if not shakeEnabled() then
		return
	end
	shakePower = math.max(shakePower, power)
	shakeUntil = math.max(shakeUntil, os.clock() + seconds)
end

function PlayerFx.fov(target: number, seconds: number)
	local cam = Workspace.CurrentCamera
	if not cam or not shakeEnabled() then
		return
	end
	TweenService:Create(cam, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = target }):Play()
	task.delay(seconds, function()
		TweenService:Create(cam, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { FieldOfView = 70 }):Play()
	end)
end

function PlayerFx.confetti()
	local hrp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = true, false, false, false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = hrp.Position + Vector3.new(0, 4, 0)
	anchor.Parent = Workspace
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0
	pe.Lifetime = NumberRange.new(1.6, 2.6)
	pe.Speed = NumberRange.new(24, 48)
	pe.SpreadAngle = Vector2.new(70, 70)
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-300, 300)
	pe.Acceleration = Vector3.new(0, -45, 0)
	pe.LightEmission = 0.4
	pe.Size = NumberSequence.new(0.7)
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 200)), ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 215, 90)),
		ColorSequenceKeypoint.new(0.7, Color3.fromRGB(70, 240, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 120, 255)),
	})
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.8, 0), NumberSequenceKeypoint.new(1, 1) })
	pe.Parent = anchor
	pe:Emit(140)
	Debris:AddItem(anchor, 3)
end

-- ===== per-character visuals =====
local function clearVisuals(char: Model)
	for _, n in { "NfTrail", "NfTrailA", "NfTrailB", "NfAura", "NfPlate" } do
		local x = char:FindFirstChild(n, true)
		if x then
			x:Destroy()
		end
	end
end

local function applyCosmetics(player: Player, char: Model)
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = char:FindFirstChild("Head") :: BasePart?
	if not hrp then
		return
	end
	clearVisuals(char)
	local trail = trailById[player:GetAttribute("Trail") or ""]
	if trail then
		local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
		a0.Name, a1.Name = "NfTrailA", "NfTrailB"
		a0.Position, a1.Position = Vector3.new(0, 1.4, 0), Vector3.new(0, -1.6, 0)
		a0.Parent, a1.Parent = hrp, hrp
		local tr = Instance.new("Trail")
		tr.Name = "NfTrail"
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime = 0.7
		tr.LightEmission = 1
		tr.FaceCamera = true
		tr.MinLength = 0.1
		tr.Color = ColorSequence.new(UIKit.rgb(trail.color), UIKit.rgb(trail.accent))
		tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
		tr.Parent = hrp
	end
	local aura = auraById[player:GetAttribute("Aura") or ""]
	if aura then
		local att = Instance.new("Attachment")
		att.Name = "NfAura"
		att.Parent = hrp
		local pe = Instance.new("ParticleEmitter")
		pe.Rate = 16
		pe.Lifetime = NumberRange.new(1, 1.8)
		pe.Speed = NumberRange.new(1, 3)
		pe.Shape = Enum.ParticleEmitterShape.Cylinder
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		pe.Acceleration = Vector3.new(0, 4, 0)
		pe.LightEmission = 1
		pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		pe.Color = ColorSequence.new(UIKit.rgb(aura.color))
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.9), NumberSequenceKeypoint.new(1, 0) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(1, 1) })
		pe.Parent = att
	end
	-- name plate: title, name, crowns (replaces the default overhead name)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	if head then
		local gui = Instance.new("BillboardGui")
		gui.Name = "NfPlate"
		gui.Size = UDim2.fromOffset(220, 62)
		gui.StudsOffset = Vector3.new(0, 3.1, 0)
		gui.AlwaysOnTop = false
		gui.MaxDistance = 90
		gui.LightInfluence = 0
		gui.Adornee = head
		local title = UIKit.label({ Size = UDim2.new(1, 0, 0, 16), Text = tostring(player:GetAttribute("TitleText") or ""), TextSize = 13, Font = T.fontBold, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Parent = gui })
		title.TextStrokeTransparency = 0.4
		local name = UIKit.title({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 16), Text = player.DisplayName, TextSize = 21, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Parent = gui })
		name.TextStrokeTransparency = 0.3
		local crowns = tonumber(player:GetAttribute("Crowns")) or 0
		local od = tonumber(player:GetAttribute("Overdrive")) or 0
		local stat = UIKit.label({
			Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 41), Text = ("Crowns %d%s"):format(crowns, if od > 0 then ("  -  Overdrive %d"):format(od) else ""), TextSize = 12,
			Font = T.fontBold, TextColor3 = T.magenta, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Parent = gui,
		})
		stat.TextStrokeTransparency = 0.4
		gui.Parent = head
	end
end

local function watch(player: Player)
	local function refresh()
		local char = player.Character
		if char then
			applyCosmetics(player, char)
		end
	end
	player.CharacterAdded:Connect(function(char)
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Head", 10)
		task.wait(0.2)
		applyCosmetics(player, char)
	end)
	for _, attr in { "Trail", "Aura", "TitleText", "Crowns", "Overdrive" } do
		player:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	if player.Character then
		task.defer(refresh)
	end
end

function PlayerFx.init()
	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerAdded:Connect(watch)
	local me = Players.LocalPlayer

	Remotes.get("Notify").OnClientEvent:Connect(function(n)
		if type(n) == "table" and n.kind == "fx" then
			if n.what == "speed" then
				PlayerFx.fov(88, n.seconds or 3)
			elseif n.what == "bounce" then
				PlayerFx.fov(82, 0.8)
				PlayerFx.shake(0.25, 0.2)
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		local char = me.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			local now = os.clock()
			if now < shakeUntil then
				local k = (shakeUntil - now) * shakePower
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			elseif hum.CameraOffset ~= Vector3.zero then
				hum.CameraOffset = Vector3.zero
				shakePower = 0
			end
		end
	end)
	Feedback.setEffects(PlayerFx.shake, PlayerFx.confetti)
end

return PlayerFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PlotVisuals</string>
            <string name="Source"><![CDATA[-- Draws the factory ores. Ores are not server parts: each client reproduces the deterministic schedule the server
-- uses for income (dropper phase + interval on the shared server clock), so what you see is what you earn.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Feedback = require(script.Parent.Feedback)

local PlotVisuals = {}

local FALL_TIME, COLLECTOR_X = 0.45, 35
local DRAW_RANGE = 340
local BELT_Y = Config.Plots.BELT_Y

local pool: { [Instance]: { BasePart } } = {}
local function ensurePool(folder: Instance, n: number): { BasePart }
	local list = pool[folder]
	if not list then
		list = {}
		pool[folder] = list
	end
	while #list < n do
		local p = Instance.new("Part")
		p.Name = "Ore"
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(1.7, 1.7, 1.7)
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
		p.Material = Enum.Material.Neon
		p.Transparency = 1
		p.Parent = Workspace
		table.insert(list, p)
	end
	return list
end

local function phaseOf(id: string, interval: number): number
	local h = 0
	for i = 1, #id do
		h = (h * 31 + string.byte(id, i)) % 9973
	end
	return (h / 9973) * interval
end

local function updatePlot(folder: Folder, origin: CFrame, now: number)
	local used = 0
	local droppers = {}
	for _, it in Config.Items do
		if it.kind == "dropper" and folder:FindFirstChild(it.id) then
			table.insert(droppers, it)
		end
	end
	local list = ensurePool(folder, 40)
	for _, it in droppers do
		local transit = FALL_TIME + (COLLECTOR_X - it.x) / Config.Tycoon.BELT_SPEED
		local ph = phaseOf(it.id, it.interval)
		local first = math.ceil((now - transit - ph) / it.interval)
		local last = math.floor((now - ph) / it.interval)
		for n = first, last do
			local age = now - (n * it.interval + ph)
			if age >= 0 and age < transit and used < #list then
				used += 1
				local x, y
				if age < FALL_TIME then
					local k = age / FALL_TIME
					x, y = it.x, 10 + BELT_Y - (10 - 1.1) * k * k
				else
					x, y = it.x + (age - FALL_TIME) * Config.Tycoon.BELT_SPEED, BELT_Y + 1.1
				end
				local ore = list[used]
				ore.Color = Color3.fromRGB(it.color[1], it.color[2], it.color[3])
				ore.Transparency = 0
				ore.CFrame = origin * CFrame.new(x, y, 0)
			end
		end
	end
	for i = used + 1, #list do
		if list[i].Transparency ~= 1 then
			list[i].Transparency = 1
		end
	end
end

local function hideAll(folder: Instance)
	local list = pool[folder]
	if list then
		for _, p in list do
			p.Transparency = 1
		end
	end
end

function PlotVisuals.init()
	local factories = Workspace:WaitForChild("Factories")
	local player = Players.LocalPlayer
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		if acc < 1 / 30 then
			return
		end
		acc = 0
		local cam = Workspace.CurrentCamera
		local now = Workspace:GetServerTimeNow()
		for _, folder in factories:GetChildren() do
			local origin = folder:GetAttribute("Origin")
			if typeof(origin) == "CFrame" and cam and (origin.Position - cam.CFrame.Position).Magnitude < DRAW_RANGE and folder:FindFirstChild("Belt") then
				updatePlot(folder :: Folder, origin, now)
			else
				hideAll(folder)
			end
		end
	end)

	-- income feedback at the collector of your own plot
	Remotes.get("CashTick").OnClientEvent:Connect(function(amount: number)
		local d = State.data
		local idx = d and d.plot
		if not idx or amount <= 0 then
			return
		end
		local folder = factories:FindFirstChild("Plot" .. idx)
		local origin = folder and folder:GetAttribute("Origin")
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if typeof(origin) == "CFrame" and hrp then
			local at = (origin * CFrame.new(COLLECTOR_X, BELT_Y + 8, 0)).Position
			if (hrp.Position - at).Magnitude < 130 then
				Feedback.floatAt(at, "+$" .. UIKit.fmt(amount), UIKit.theme.gold, UIKit.px(20))
			end
		end
	end)
end

return PlotVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SettingsPanel</string>
            <string name="Source"><![CDATA[-- Settings: sound / music / camera shake toggles (saved on the server) and a controls cheat-sheet.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Menus = require(script.Parent.Menus)
local Sfx = require(script.Parent.Sfx)

local SettingsPanel = {}
local T = UIKit.theme

function SettingsPanel.create(gui: ScreenGui)
	local frame, content = UIKit.panel(gui, "Settings", function()
		Menus.close()
	end)
	local list = UIKit.scroll({ Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Parent = content })
	UIKit.list(list, 8)
	UIKit.pad(4).Parent = list

	local function render()
		local d = State.data
		if not d then
			return
		end
		UIKit.clear(list)
		local order = 0
		local function toggle(label: string, key: string)
			order += 1
			local on = d.settings[key] ~= false
			local r = UIKit.new("Frame", { Size = UDim2.new(1, -8, 0, UIKit.px(42)), BackgroundColor3 = T.panel, BorderSizePixel = 0, LayoutOrder = order, Parent = list }, { UIKit.corner(10) })
			UIKit.label({ Size = UDim2.new(1, -UIKit.px(100), 1, 0), Position = UDim2.fromOffset(12, 0), Text = label, TextSize = UIKit.px(14), Parent = r })
			UIKit.button({
				Size = UDim2.fromOffset(UIKit.px(72), UIKit.px(28)), Position = UDim2.new(1, -UIKit.px(80), 0.5, -UIKit.px(14)), Text = if on then "ON" else "OFF", style = if on then "primary" else "ghost", Parent = r,
			}, function()
				pcall(function()
					Remotes.get("SetSetting"):InvokeServer(key, not on)
				end)
			end)
		end
		toggle("Sound effects", "sfx")
		toggle("Music", "music")
		toggle("Camera shake and speed lines", "shake")
		order += 1
		UIKit.label({
			Size = UDim2.new(1, -8, 0, UIKit.px(170)), LayoutOrder = order, TextSize = UIKit.px(13), TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top, Parent = list,
			Text = "HOW TO PLAY\n"
				.. "1. Your factory makes cash by itself. Walk onto the glowing pad behind it to buy the next machine.\n"
				.. "2. Press TO TOWER to climb the 12-floor tower. Touch checkpoints to save your spot; clearing a floor pays crowns, cash and a trail.\n"
				.. "3. Crowns multiply your factory income. Collect coins, buy perks, and build the Overdrive Reactor to prestige.\n\n"
				.. "PC: WASD + Space (Space again in the air with Double Jump).  Mobile: thumbstick + jump button.\n"
				.. "Progress saves automatically every minute and when you leave.",
		})
	end

	Menus.register("settings", frame, render)
	State.changed:Connect(function()
		if frame.Visible then
			render()
		end
		Sfx.refresh()
	end)
end

return SettingsPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[-- Sound effects + zone music. Asset ids come from shared/AudioIds (paste ids after uploading /audio); empty ids
-- fall back to engine sounds (sfx) or silence (music). Respects the sfx / music settings.
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local AudioIds = require(Shared.AudioIds)
local State = require(script.Parent.State)

local Sfx = {}

local lastPlayed: { [string]: number } = {}

local function assetId(v: any): string
	if v == nil or v == "" or v == 0 then
		return ""
	end
	local s = tostring(v)
	if s:sub(1, 6) == "rbxass" or s:sub(1, 6) == "rbxasset" then
		return s
	end
	return "rbxassetid://" .. s
end

local function setting(key: string): boolean
	local d = State.data
	return not d or d.settings[key] ~= false
end

function Sfx.play(name: string, pitchScale: number?)
	local cfg = Config.Sfx[name]
	if not cfg or not setting("sfx") then
		return
	end
	local now = os.clock()
	if lastPlayed[name] and now - lastPlayed[name] < 0.04 then
		return
	end
	lastPlayed[name] = now
	local id = assetId(AudioIds.sfx[name])
	local custom = id ~= ""
	local s = Instance.new("Sound")
	s.SoundId = if custom then id else cfg.fallback
	s.Volume = cfg.volume * (if custom then 1.4 else 1)
	s.PlaybackSpeed = (if custom then 1 else cfg.pitch) * (pitchScale or 1)
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 6)
end

-- ===== music: two sounds crossfaded =====
local current: Sound? = nil
local currentName = ""
local MUSIC_VOLUME = 0.32

function Sfx.music(track: string)
	if track == currentName then
		return
	end
	currentName = track
	local id = assetId(AudioIds.music[track])
	if current then
		local old = current
		TweenService:Create(old, TweenInfo.new(1.5), { Volume = 0 }):Play()
		Debris:AddItem(old, 1.8)
		current = nil
	end
	if id == "" or not setting("music") then
		return
	end
	local s = Instance.new("Sound")
	s.Name = "Music_" .. track
	s.SoundId = id
	s.Looped = true
	s.Volume = 0
	s.Parent = SoundService
	s:Play()
	TweenService:Create(s, TweenInfo.new(2), { Volume = MUSIC_VOLUME }):Play()
	current = s
end

-- apply a changed music setting right away (ZoneFx requests the track again on its next tick when re-enabled)
function Sfx.refresh()
	if not setting("music") and current then
		current:Destroy()
		current = nil
		currentName = ""
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ShopPanel</string>
            <string name="Source"><![CDATA[-- Shop: Overdrive (prestige), perks and floor skips. Every purchase is a server request.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Menus = require(script.Parent.Menus)
local Sfx = require(script.Parent.Sfx)

local ShopPanel = {}
local T = UIKit.theme

local REASONS = {
	funds = "Not enough cash yet.", owned = "You already own that.", invalid = "Not available.", slow_down = "One moment...",
	locked = "Not available yet.", top = "You are already at the top floor.", no_session = "Still loading...",
}

function ShopPanel.create(gui: ScreenGui, toast: (string, string?) -> ())
	local frame, content = UIKit.panel(gui, "Shop", function()
		Menus.close()
	end)
	local list = UIKit.scroll({ Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Parent = content })
	UIKit.list(list, 8)
	UIKit.pad(4).Parent = list
	local busy = false

	local function request(remote: string, ...)
		if busy then
			return
		end
		busy = true
		local args = { ... }
		local ok, res = pcall(function()
			return Remotes.get(remote):InvokeServer(table.unpack(args))
		end)
		busy = false
		if not ok or not res then
			toast("Could not reach the server.", "warn")
		elseif not res.ok then
			Sfx.play("deny")
			toast(REASONS[res.reason] or "Not possible right now.", "warn")
		end
	end

	local function card(order: number, height: number, accent: Color3): Frame
		return UIKit.new("Frame", { Size = UDim2.new(1, -8, 0, height), BackgroundColor3 = T.panel, BorderSizePixel = 0, LayoutOrder = order, Parent = list }, { UIKit.corner(12), UIKit.stroke(accent, 1.5, 0.3) })
	end

	local function render()
		local d = State.data
		if not d then
			return
		end
		UIKit.clear(list)
		local order = 0
		-- Overdrive
		order += 1
		local od = card(order, UIKit.px(96), T.magenta)
		UIKit.title({ Size = UDim2.new(1, -20, 0, UIKit.px(26)), Position = UDim2.fromOffset(12, 6), Text = "OVERDRIVE", TextSize = UIKit.px(20), TextColor3 = T.magenta, TextWrapped = false, Parent = od })
		UIKit.label({
			Size = UDim2.new(1, -24, 0, UIKit.px(32)), Position = UDim2.fromOffset(12, UIKit.px(32)),
			Text = ("Reset your factory for +%d%% cash forever (now x%d). Keeps crowns, floors, perks and cosmetics. Factory pieces cost %d%% more each time."):format(Config.Tycoon.OVERDRIVE_BONUS * 100, d.overdrive, Config.Tycoon.OVERDRIVE_COST_GROWTH * 100),
			TextSize = UIKit.px(12), TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top, Parent = od,
		})
		UIKit.button({
			Size = UDim2.new(1, -24, 0, UIKit.px(28)), Position = UDim2.new(0, 12, 1, -UIKit.px(34)),
			Text = if d.canOverdrive then "TRIGGER OVERDRIVE" else "Build the Overdrive Reactor in your factory first", style = if d.canOverdrive then "gold" else "disabled", Parent = od,
		}, function()
			if d.canOverdrive then
				request("Overdrive")
			else
				Sfx.play("deny")
			end
		end)
		-- perks
		for _, perk in Config.Perks do
			order += 1
			local owned = d.perks[perk.id] == true
			local c = card(order, UIKit.px(70), if owned then T.good else T.cyan)
			UIKit.title({ Size = UDim2.new(0.6, 0, 0, UIKit.px(24)), Position = UDim2.fromOffset(12, 6), Text = perk.name, TextSize = UIKit.px(17), TextWrapped = false, Parent = c })
			UIKit.label({ Size = UDim2.new(1, -UIKit.px(150), 0, UIKit.px(30)), Position = UDim2.fromOffset(12, UIKit.px(32)), Text = perk.desc, TextSize = UIKit.px(12), TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top, Parent = c })
			local afford = d.cash >= perk.cost
			UIKit.button({
				Size = UDim2.fromOffset(UIKit.px(130), UIKit.px(34)), Position = UDim2.new(1, -UIKit.px(138), 0.5, -UIKit.px(17)),
				Text = if owned then "OWNED" else ("$" .. UIKit.fmt(perk.cost)), style = if owned then "disabled" elseif afford then "primary" else "ghost", Parent = c,
			}, function()
				if not owned then
					request("BuyPerk", perk.id)
				end
			end)
		end
		-- skip
		order += 1
		local sk = card(order, UIKit.px(70), T.warn)
		UIKit.title({ Size = UDim2.new(0.6, 0, 0, UIKit.px(24)), Position = UDim2.fromOffset(12, 6), Text = "Skip Floor", TextSize = UIKit.px(17), TextWrapped = false, Parent = sk })
		UIKit.label({
			Size = UDim2.new(1, -UIKit.px(150), 0, UIKit.px(30)), Position = UDim2.fromOffset(12, UIKit.px(32)),
			Text = "Move your checkpoint up one floor without rewards. You can still climb the floor yourself later.", TextSize = UIKit.px(12), TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top, Parent = sk,
		})
		local cost = d.skipCost
		UIKit.button({
			Size = UDim2.fromOffset(UIKit.px(130), UIKit.px(34)), Position = UDim2.new(1, -UIKit.px(138), 0.5, -UIKit.px(17)),
			Text = if cost then ("$" .. UIKit.fmt(cost)) else "TOP", style = if cost and d.cash >= cost then "primary" else "ghost", Parent = sk,
		}, function()
			if cost then
				request("Skip")
			end
		end)
	end

	Menus.register("shop", frame, render)
	State.changed:Connect(function()
		if frame.Visible then
			render()
		end
	end)
end

return ShopPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[-- Minimal signal: Connect(fn) -> disconnect function, Fire(...).
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ handlers = {} :: { [number]: (...any) -> () }, nextId = 0 }, Signal)
end

function Signal:Connect(fn: (...any) -> ()): () -> ()
	self.nextId += 1
	local id = self.nextId
	self.handlers[id] = fn
	return function()
		self.handlers[id] = nil
	end
end

function Signal:Fire(...)
	for _, fn in table.clone(self.handlers) do
		task.spawn(fn, ...)
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Client mirror of the server snapshot.
local Signal = require(script.Parent.Signal)

local State = {}

State.data = nil :: any
State.changed = Signal.new()

function State.set(snapshot: any)
	snapshot._at = os.clock()
	State.data = snapshot
	State.changed:Fire(snapshot)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">StylePanel</string>
            <string name="Source"><![CDATA[-- Style: trails (unlocked per floor), auras (unlocked by crowns) and titles.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Menus = require(script.Parent.Menus)
local Sfx = require(script.Parent.Sfx)

local StylePanel = {}
local T = UIKit.theme

function StylePanel.create(gui: ScreenGui)
	local frame, content = UIKit.panel(gui, "Style", function()
		Menus.close()
	end)
	local list = UIKit.scroll({ Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Parent = content })
	UIKit.list(list, 6)
	UIKit.pad(4).Parent = list

	local function equip(kind: string, id: string)
		pcall(function()
			Remotes.get("Equip"):InvokeServer(kind, id)
		end)
	end

	local function render()
		local d = State.data
		if not d then
			return
		end
		UIKit.clear(list)
		local order = 0
		local function header(text: string)
			order += 1
			UIKit.title({ Size = UDim2.new(1, -8, 0, UIKit.px(28)), Text = text, TextSize = UIKit.px(18), TextColor3 = T.cyan, TextWrapped = false, LayoutOrder = order, Parent = list })
		end
		local function row(name: string, sub: string, color: Color3, owned: boolean, equipped: boolean, onEquip: () -> ())
			order += 1
			local r = UIKit.new("Frame", { Size = UDim2.new(1, -8, 0, UIKit.px(46)), LayoutOrder = order, BackgroundColor3 = T.panel, BorderSizePixel = 0, Parent = list }, { UIKit.corner(10), UIKit.stroke(color, if equipped then 2.5 else 1, if owned then 0.1 else 0.7) })
			UIKit.new("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(12, UIKit.px(17)), BackgroundColor3 = color, BorderSizePixel = 0, Parent = r }, { UIKit.corner(6) })
			UIKit.label({ Size = UDim2.new(1, -UIKit.px(170), 0, UIKit.px(20)), Position = UDim2.fromOffset(34, 4), Text = name, TextSize = UIKit.px(14), Font = T.fontBold, TextColor3 = if owned then T.text else T.dim, TextWrapped = false, Parent = r })
			UIKit.label({ Size = UDim2.new(1, -UIKit.px(170), 0, UIKit.px(16)), Position = UDim2.fromOffset(34, UIKit.px(24)), Text = sub, TextSize = UIKit.px(11), TextColor3 = T.dim, TextWrapped = false, Parent = r })
			UIKit.button({
				Size = UDim2.fromOffset(UIKit.px(100), UIKit.px(30)), Position = UDim2.new(1, -UIKit.px(108), 0.5, -UIKit.px(15)),
				Text = if equipped then "WORN" elseif owned then "WEAR" else "LOCKED", style = if equipped then "disabled" elseif owned then "primary" else "disabled", Parent = r,
			}, function()
				if owned and not equipped then
					Sfx.play("unlock")
					onEquip()
				end
			end)
		end
		header("Trails")
		row("No trail", "Plain and simple", T.dim, true, d.trail == "", function() equip("trail", "") end)
		for _, tr in Config.Trails do
			row(tr.name, ("Clear floor %d"):format(tr.floor), UIKit.rgb(tr.color), d.trails[tr.id] == true, d.trail == tr.id, function() equip("trail", tr.id) end)
		end
		header("Auras")
		row("No aura", "Keep it clean", T.dim, true, d.aura == "", function() equip("aura", "") end)
		for _, au in Config.Auras do
			row(au.name, ("%d crowns"):format(au.crowns), UIKit.rgb(au.color), d.auras[au.id] == true, d.aura == au.id, function() equip("aura", au.id) end)
		end
		header("Titles")
		for _, ti in Config.Titles do
			local owned = d.crowns >= ti.crowns
			row(ti.id, ("%d crowns"):format(ti.crowns), T.gold, owned, d.title == ti.id, function() equip("title", ti.id) end)
		end
	end

	Menus.register("style", frame, render)
	State.changed:Connect(function()
		if frame.Visible then
			render()
		end
	end)
end

return StylePanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">TowerPanel</string>
            <string name="Source"><![CDATA[-- Tower: the twelve floors with their status; jump to any floor you reached.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Menus = require(script.Parent.Menus)
local Sfx = require(script.Parent.Sfx)

local TowerPanel = {}
local T = UIKit.theme

function TowerPanel.create(gui: ScreenGui, toast: (string, string?) -> ())
	local frame, content = UIKit.panel(gui, "Tower", function()
		Menus.close()
	end)
	local header = UIKit.label({ Size = UDim2.new(1, -24, 0, UIKit.px(34)), Position = UDim2.fromOffset(12, 0), Text = "", TextSize = UIKit.px(13), Font = T.fontBold, TextColor3 = T.cyan, Parent = content })
	local list = UIKit.scroll({ Size = UDim2.new(1, -16, 1, -UIKit.px(40)), Position = UDim2.fromOffset(8, UIKit.px(38)), Parent = content })
	UIKit.list(list, 6)
	UIKit.pad(4).Parent = list

	local function render()
		local d = State.data
		if not d then
			return
		end
		UIKit.clear(list)
		header.Text = ("Deaths %d    Coins %d    Floors cleared %d/%d    Checkpoint: floor %d"):format(d.counters.deaths, d.counters.coins, d.counters.floorsCleared, Config.Tower.FLOORS, d.checkpoint)
		for _, fl in Config.Floors do
			local cleared = d.floors[tostring(fl.id)] == true
			local reachable = fl.id <= d.reached
			local c = UIKit.new("Frame", {
				Size = UDim2.new(1, -8, 0, UIKit.px(54)), LayoutOrder = fl.id, BackgroundColor3 = T.panel, BorderSizePixel = 0, Parent = list,
			}, { UIKit.corner(10), UIKit.stroke(UIKit.rgb(fl.glow), if fl.id == d.checkpoint then 3 else 1.2, if reachable then 0.1 else 0.7) })
			UIKit.new("Frame", { Size = UDim2.fromOffset(8, UIKit.px(54)), BackgroundColor3 = UIKit.rgb(fl.main), BorderSizePixel = 0, Parent = c }, { UIKit.corner(4) })
			UIKit.title({ Size = UDim2.new(1, -UIKit.px(190), 0, UIKit.px(22)), Position = UDim2.fromOffset(18, 6), Text = ("%d. %s"):format(fl.id, fl.name), TextSize = UIKit.px(16), TextColor3 = if reachable then UIKit.rgb(fl.glow) else T.dim, TextWrapped = false, Parent = c })
			UIKit.label({
				Size = UDim2.new(1, -UIKit.px(190), 0, UIKit.px(18)), Position = UDim2.fromOffset(18, UIKit.px(30)),
				Text = if cleared then "Cleared" elseif reachable then "Reached - not cleared yet" else "Locked", TextSize = UIKit.px(12), TextColor3 = if cleared then T.good else T.dim, TextWrapped = false, Parent = c,
			})
			UIKit.button({
				Size = UDim2.fromOffset(UIKit.px(110), UIKit.px(32)), Position = UDim2.new(1, -UIKit.px(118), 0.5, -UIKit.px(16)),
				Text = if reachable then "GO" else "LOCKED", style = if reachable then "primary" else "disabled", Parent = c,
			}, function()
				if reachable then
					local ok, res = pcall(function()
						return Remotes.get("GotoFloor"):InvokeServer(fl.id)
					end)
					if ok and res and res.ok then
						Menus.close()
					elseif ok and res and res.reason == "cooldown" then
						toast("Wait a moment before travelling again.", "warn")
					end
				else
					Sfx.play("deny")
				end
			end)
		end
	end

	Menus.register("tower", frame, render)
	State.changed:Connect(function()
		if frame.Visible then
			render()
		end
	end)
end

return TowerPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[-- Themed UI factory + helpers shared by every panel. All interfaces are real Roblox GUI objects.
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UIKit = {}

UIKit.theme = {
	bg = Color3.fromRGB(16, 12, 34),
	panel = Color3.fromRGB(28, 22, 58),
	panel2 = Color3.fromRGB(46, 38, 86),
	cyan = Color3.fromRGB(70, 240, 255),
	magenta = Color3.fromRGB(255, 70, 200),
	gold = Color3.fromRGB(255, 215, 90),
	good = Color3.fromRGB(110, 235, 140),
	bad = Color3.fromRGB(255, 96, 116),
	warn = Color3.fromRGB(255, 200, 80),
	text = Color3.fromRGB(244, 242, 255),
	dim = Color3.fromRGB(165, 158, 198),
	fontTitle = Enum.Font.FredokaOne,
	font = Enum.Font.GothamMedium,
	fontBold = Enum.Font.GothamBold,
}
local T = UIKit.theme

function UIKit.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function UIKit.factor(): number
	local cam = Workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	return math.clamp(math.min(vp.X / 1100, vp.Y / 620), 0.85, 1.35)
end

function UIKit.px(n: number): number
	return math.max(11, math.floor(n * UIKit.factor() + 0.5))
end

function UIKit.new(class: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(class)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UIKit.corner(r: number?): UICorner
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

function UIKit.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UIKit.new("UIStroke", { Color = color or T.panel2, Thickness = thickness or 1.5, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UIKit.pad(px: number): UIPadding
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
	})
end

function UIKit.label(props: { [string]: any }): TextLabel
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or T.text
	props.Font = props.Font or T.font
	props.TextSize = props.TextSize or UIKit.px(15)
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextWrapped = if props.TextWrapped == nil then true else props.TextWrapped
	return UIKit.new("TextLabel", props)
end

function UIKit.title(props: { [string]: any }): TextLabel
	props.Font = T.fontTitle
	return UIKit.label(props)
end

function UIKit.list(parent: Instance, padding: number?, horizontal: boolean?): UIListLayout
	return UIKit.new("UIListLayout", {
		Padding = UDim.new(0, padding or 6), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical, Parent = parent,
	})
end

function UIKit.clear(frame: Instance)
	for _, c in frame:GetChildren() do
		if not c:IsA("UIListLayout") and not c:IsA("UIPadding") and not c:IsA("UIGridLayout") and not c:IsA("UISizeConstraint") then
			c:Destroy()
		end
	end
end

function UIKit.scroll(props: { [string]: any }): ScrollingFrame
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.BorderSizePixel = 0
	props.ScrollBarThickness = props.ScrollBarThickness or 5
	props.ScrollBarImageColor3 = T.magenta
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.CanvasSize = UDim2.new()
	props.ScrollingDirection = Enum.ScrollingDirection.Y
	return UIKit.new("ScrollingFrame", props)
end

UIKit.onClickSound = nil :: (() -> ())?

-- style: primary (cyan) | gold | ghost | danger | disabled
function UIKit.button(props: { [string]: any }, onClick: (() -> ())?): TextButton
	local style = props.style or "primary"
	props.style = nil
	local base, fg
	if style == "primary" then
		base, fg = T.cyan, Color3.fromRGB(14, 10, 30)
	elseif style == "gold" then
		base, fg = T.gold, Color3.fromRGB(40, 24, 0)
	elseif style == "danger" then
		base, fg = T.bad, Color3.new(1, 1, 1)
	elseif style == "disabled" then
		base, fg = T.panel2, T.dim
	else
		base, fg = T.panel2, T.text
	end
	props.BackgroundColor3 = props.BackgroundColor3 or base
	props.TextColor3 = props.TextColor3 or fg
	props.Font = props.Font or T.fontBold
	props.TextSize = props.TextSize or UIKit.px(15)
	props.AutoButtonColor = false
	props.BorderSizePixel = 0
	local b: TextButton = UIKit.new("TextButton", props, { UIKit.corner(10) })
	local normal = b.BackgroundColor3
	local hover = normal:Lerp(Color3.new(1, 1, 1), 0.2)
	local function tween(color: Color3)
		TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = color }):Play()
	end
	b.MouseEnter:Connect(function()
		if style ~= "disabled" then
			tween(hover)
		end
	end)
	b.MouseLeave:Connect(function()
		tween(normal)
	end)
	b.MouseButton1Down:Connect(function()
		if style ~= "disabled" then
			tween(normal:Lerp(Color3.new(0, 0, 0), 0.18))
		end
	end)
	b.MouseButton1Up:Connect(function()
		tween(normal)
	end)
	if onClick then
		b.Activated:Connect(function()
			if UIKit.onClickSound then
				UIKit.onClickSound()
			end
			onClick()
		end)
	end
	return b
end

function UIKit.bar(props: { [string]: any }, fillColor: Color3?)
	local root = UIKit.new("Frame", {
		BackgroundColor3 = T.bg, BorderSizePixel = 0, Size = props.Size or UDim2.new(1, 0, 0, 14), Position = props.Position,
		LayoutOrder = props.LayoutOrder, Parent = props.Parent,
	}, { UIKit.corner(6), UIKit.stroke(T.panel2, 1) })
	local fill = UIKit.new("Frame", { BackgroundColor3 = fillColor or T.cyan, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = root }, { UIKit.corner(6) })
	local text = UIKit.label({
		Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextSize = props.TextSize or UIKit.px(12),
		Font = T.fontBold, Text = "", TextWrapped = false, ZIndex = 3, Parent = root,
	})
	local function set(fraction: number, label: string?, color: Color3?)
		TweenService:Create(fill, TweenInfo.new(0.18), { Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1) }):Play()
		if label then
			text.Text = label
		end
		if color then
			fill.BackgroundColor3 = color
		end
	end
	return root, set
end

function UIKit.panel(gui: Instance, title: string, onClose: () -> ()): (Frame, Frame)
	local frame = UIKit.new("Frame", {
		Name = title, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.94, 0.9),
		BackgroundColor3 = T.bg, BorderSizePixel = 0, Visible = false, Active = true, ZIndex = 10, Parent = gui,
	}, {
		UIKit.corner(16), UIKit.stroke(T.magenta, 2.5, 0.2),
		UIKit.new("UISizeConstraint", { MaxSize = Vector2.new(880, 580), MinSize = Vector2.new(300, 220) }),
	})
	UIKit.title({ Size = UDim2.new(1, -70, 0, UIKit.px(40)), Position = UDim2.fromOffset(18, 4), Text = title, TextSize = UIKit.px(26), TextColor3 = T.cyan, Parent = frame, TextWrapped = false })
	UIKit.button({
		Size = UDim2.fromOffset(UIKit.px(36), UIKit.px(30)), Position = UDim2.new(1, -UIKit.px(36) - 12, 0, 8), Text = "X", style = "ghost", Parent = frame,
	}, onClose)
	local top = UIKit.px(46)
	local content = UIKit.new("Frame", { Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top), BackgroundTransparency = 1, Parent = frame })
	return frame, content
end

function UIKit.fmt(n: number): string
	n = math.floor(n)
	if n >= 1e12 then
		return ("%.2fT"):format(n / 1e12)
	elseif n >= 1e9 then
		return ("%.2fB"):format(n / 1e9)
	elseif n >= 1e6 then
		return ("%.2fM"):format(n / 1e6)
	elseif n >= 1e5 then
		return ("%.1fK"):format(n / 1e3)
	end
	local s = tostring(n)
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function UIKit.rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

return UIKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ZoneFx</string>
            <string name="Source"><![CDATA[-- Each floor has its own sky, light, haze, falling particles and music. Everything blends smoothly as you climb.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sfx = require(script.Parent.Sfx)
local UIKit = require(script.Parent.UIKit)
local Feedback = require(script.Parent.Feedback)

local ZoneFx = {}
local T = Config.Tower

local HUB = { top = { 170, 110, 255 }, haze = { 190, 140, 255 }, ambient = { 90, 70, 140 }, brightness = 2.2, clock = 20.5, particles = "sparkle" }
local PER_FLOOR = T.MODULES_PER_FLOOR * T.RISE_PER_MODULE

local function zoneOf(pos: Vector3): number
	local horiz = math.sqrt(pos.X * pos.X + pos.Z * pos.Z)
	if horiz > 175 or pos.Y < T.BASE_Y - 2 then
		return 0
	end
	return math.clamp(math.floor((pos.Y - T.BASE_Y + 3) / PER_FLOOR) + 1, 1, T.FLOORS)
end
ZoneFx.zoneOf = zoneOf

local cur = { top = Vector3.new(170, 110, 255), haze = Vector3.new(190, 140, 255), ambient = Vector3.new(90, 70, 140), brightness = 2.2, clock = 20.5 }
local function v3(c: { number }): Vector3
	return Vector3.new(c[1], c[2], c[3])
end
local function col(v: Vector3): Color3
	return Color3.fromRGB(math.clamp(v.X, 0, 255), math.clamp(v.Y, 0, 255), math.clamp(v.Z, 0, 255))
end

local emitterPart: Part, emitter: ParticleEmitter
local zone, lastBanner = -1, -1

local function recipe(kind: string, glow: { number }, accent: { number })
	emitter.Color = ColorSequence.new(UIKit.rgb(glow), UIKit.rgb(accent))
	emitter.Acceleration = Vector3.zero
	emitter.Rate = 30
	emitter.Lifetime = NumberRange.new(4, 8)
	emitter.Speed = NumberRange.new(0.5, 2)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.8), NumberSequenceKeypoint.new(1, 0) })
	emitter.LightEmission = 0.8
	if kind == "ember" then
		emitter.Acceleration = Vector3.new(0, 5, 0)
		emitter.Speed = NumberRange.new(2, 5)
	elseif kind == "snow" or kind == "petal" or kind == "leaf" then
		emitter.Acceleration = Vector3.new(0, -3, 0)
		emitter.Rate = 45
		emitter.Size = NumberSequence.new(0.55)
	elseif kind == "rain" then
		emitter.Acceleration = Vector3.new(0, -70, 0)
		emitter.Rate = 160
		emitter.Lifetime = NumberRange.new(0.5, 0.8)
		emitter.Size = NumberSequence.new(0.18)
		emitter.Speed = NumberRange.new(0, 0)
	elseif kind == "void" then
		emitter.Speed = NumberRange.new(4, 9)
		emitter.LightEmission = 1
	elseif kind == "star" then
		emitter.Rate = 50
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 1.3), NumberSequenceKeypoint.new(1, 0) })
	end
end

function ZoneFx.init()
	local player = Players.LocalPlayer
	emitterPart = Instance.new("Part")
	emitterPart.Name = "ZoneFxVolume"
	emitterPart.Anchored, emitterPart.CanCollide, emitterPart.CanTouch, emitterPart.CanQuery = true, false, false, false
	emitterPart.Transparency = 1
	emitterPart.Size = Vector3.new(70, 36, 70)
	emitterPart.Parent = Workspace
	emitter = Instance.new("ParticleEmitter")
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Parent = emitterPart
	recipe("sparkle", { 255, 120, 220 }, { 120, 240, 255 })

	local target = { top = v3(HUB.top), haze = v3(HUB.haze), ambient = v3(HUB.ambient), brightness = HUB.brightness, clock = HUB.clock }
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			emitterPart.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 12, 0))
		end
		acc += dt
		if acc >= 0.3 and hrp then
			acc = 0
			local z = zoneOf(hrp.Position)
			if z ~= zone then
				zone = z
				local theme = if z == 0 then nil else Config.Floors[z]
				local s = if theme then theme.sky else HUB
				target = { top = v3(s.top), haze = v3(s.haze), ambient = v3(s.ambient), brightness = s.brightness, clock = s.clock }
				if theme then
					recipe(s.particles, theme.glow, theme.accent)
					Sfx.music(theme.music)
					if z ~= lastBanner then
						lastBanner = z
						Feedback.toast(("Floor %d: %s"):format(z, theme.name), "good")
					end
				else
					recipe("sparkle", { 255, 120, 220 }, { 120, 240, 255 })
					Sfx.music("hub")
				end
			end
		end
		-- ease the sky toward the target (about a second and a half)
		local k = 1 - math.exp(-dt * 1.6)
		cur.top = cur.top:Lerp(target.top, k)
		cur.haze = cur.haze:Lerp(target.haze, k)
		cur.ambient = cur.ambient:Lerp(target.ambient, k)
		cur.brightness += (target.brightness - cur.brightness) * k
		cur.clock += (target.clock - cur.clock) * k
		Lighting.ColorShift_Top = col(cur.top)
		Lighting.Ambient = col(cur.ambient)
		Lighting.OutdoorAmbient = col(cur.ambient:Lerp(cur.top, 0.35))
		Lighting.Brightness = cur.brightness
		Lighting.ClockTime = cur.clock
		local atm = Lighting:FindFirstChild("NfAtmosphere") :: Atmosphere?
		if atm then
			atm.Color = col(cur.haze)
		end
		local cc = Lighting:FindFirstChild("NfColor") :: ColorCorrectionEffect?
		if cc then
			cc.TintColor = col(Vector3.new(255, 255, 255):Lerp(cur.haze, 0.18))
		end
	end)
end

return ZoneFx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
